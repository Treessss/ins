        "description_detail_item_TtpALD": {
          "type": "description_detail_item",
          "settings": {
            "title": "Where We Ship",
            "content": "<p>Xstrapetm ships to <strong>30+ countries and regions worldwide</strong>, covering major destinations across North America, Europe, Asia-Pacific, the Middle East, and selected international markets.<br/><br/><strong>Available Shipping DestinationsNorth America </strong>United States, U.S. Outlying Islands, Canada<br/><br/><strong>Europe </strong>United Kingdom, Germany, France, Italy, Spain, Netherlands, Belgium, Sweden, Poland, Portugal, Switzerland, Norway, Denmark, Finland, Ireland, Austria, Czech Republic, Hungary, Romania, Greece, Bulgaria, Slovakia, Slovenia, Croatia, Estonia, Latvia, Lithuania, Luxembourg, Iceland, Serbia, Montenegro, Albania, Cyprus, Ukraine, Russia<br/><br/><strong>Asia-Pacific </strong>Australia, South Korea, Japan, Singapore, Malaysia, Thailand, Vietnam, Philippines, Sri Lanka, New Zealand, Réunion<br/><br/><strong>Middle East </strong>Saudi Arabia, Bahrain, Kuwait, Qatar, Israel, United Arab Emirates, Iraq<br/><br/><strong>Latin America & Other Regions </strong>Peru, Mexico, Colombia<br/><br/>Shipping rates, delivery times, and available shipping methods may vary by country or region. Certain destinations may have higher shipping fees due to international logistics costs.<br/><br/>If your country or region is shown at <strong>checkout</strong>, shipping is currently available for your address.</p>",
            "product_metafield_key": "detail_where_ship",
            "open_by_default": false,
            "icon": "picto-plane"
          }
        },
        "description_detail_item_hkaGHQ": {
          "type": "description_detail_item",
          "settings": {
            "title": "Product Care & Safety",
            "content": "<p>Choose products that suit your pet’s size and play style. Supervise play, inspect items regularly, and remove anything damaged or worn. Follow the care instructions supplied with each product.</p>",
            "product_metafield_key": "detail_care_note",
            "open_by_default": false,
            "icon": "picto-shield"
          }
        },
        "description_detail_item_c4QfUm": {
          "type": "description_detail_item",
          "settings": {
            "title": "Shipping Information",
            "content": "<p>Order Processing:<br/>Orders are processed within 1–3 business days. A tracking number will be provided via email once your order has been shipped.</p><p>Shipping Locations:<br/>We ship worldwide! No matter where you are, we’ll deliver your order to your doorstep. Shipping times may vary depending on your country or region.</p><p>Free Shipping:<br/>Orders of $50 or more qualify for free shipping. Shipping fees for smaller orders are shown at checkout.</p><p>Delays:<br/>Please note that shipping times may be delayed during holidays or due to unforeseen circumstances. We recommend placing orders early to ensure timely delivery.</p><p>Package Tracking:<br/>Once your order is dispatched, you’ll receive a tracking number to monitor your package on the carrier’s website or directly through our store.</p>",
            "product_metafield_key": "detail_shipping",
            "open_by_default": false,
            "icon": "picto-truck"
          }
        },
        "description_detail_item_MbCM8W": {
          "type": "description_detail_item",
          "settings": {
            "title": "Return Policy",
            "content": "<h5><strong>Return Policy</strong></h5><ul><li>Returns are accepted <strong>only if you received the wrong model or design</strong>.</li><li>Items must be unused, unworn, with tags, and in original packaging.</li><li>Proof of purchase is required.</li><li>Returns for other reasons (e.g., change of mind) are not accepted.</li></ul><h5>How to Return</h5><ul><li>Contact us at <a href=\"mailto:support_agent@xstrapetm.com\">support_agent@xstrapetm.com</a> with your order details and reason.</li><li>Once approved, we will send you a return label and instructions.</li><li>Please return the item within <strong>7 days</strong> of approval.</li><li>Unauthorized returns will not be accepted.</li></ul><h5>Refunds</h5><ul><li>Refunds are processed after we receive and inspect the returned item.</li><li>Approved refunds will be issued within <strong>10 business days</strong> to your original payment method.</li><li>If you haven’t received your refund within <strong>15 business days</strong>, please contact us.</li></ul><h5>Return Shipping Costs</h5><ul><li>We cover return shipping for wrong or defective items.</li><li>For other returns, customers pay the return shipping cost.</li></ul><h5>Refund Processing Fees</h5><ul><li>Refunds are subject to a non-refundable processing fee based on order status:</li><li>Within 2 hours of order: <strong>Free</strong></li><li>Order not yet in production: <strong>$2</strong></li><li>Order in production but not shipped: <strong>$3</strong></li></ul><h5>Note</h5><ul><li>Orders cannot be cancelled or refunded after shipping, except for defective or incorrect items.</li></ul><p>For full details, please refer to our complete <a href=\"/policies/refund-policy\" target=\"_blank\" title=\"Refund Policy\">Return & Refund Policy</a> page.</p>",
            "product_metafield_key": "detail_returns",
            "open_by_default": false,
            "icon": "picto-return"
          }
        },
