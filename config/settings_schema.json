      {
        "type": "range",
        "id": "block_shadow_horizontal_offset",
        "min": -32,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "水平偏移",
        "default": 0
      },
      {
        "type": "range",
        "id": "block_shadow_vertical_offset",
        "min": -32,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "垂直偏移",
        "default": 0
      },
      {
        "type": "range",
        "id": "block_shadow_blur",
        "min": 0,
        "max": 60,
        "step": 5,
        "unit": "px",
        "label": "模糊",
        "default": 50
      },
      {
        "type": "header",
        "content": "图标"
      },
      {
        "type": "range",
        "id": "icon_stroke_width",
        "min": 1,
        "max": 2,
        "step": 0.1,
        "unit": "px",
        "label": "图标粗细",
        "default": 2
      },
      {
        "type": "select",
        "id": "icon_style",
        "label": "图标样式",
        "info": "并非所有图标都有双色样式。",
        "options": [
          {
            "value": "mono",
            "label": "单色"
          },
          {
            "value": "duo",
            "label": "双色"
          }
        ],
        "default": "duo"
      },
      {
        "type": "header",
        "content": "按钮"
      },
      {
        "type": "select",
        "id": "button_style",
        "label": "按钮样式",
        "options": [
          {
            "value": "fill",
            "label": "填充"
          },
          {
            "value": "outline",
            "label": "描边"
          }
        ],
        "default": "fill"
      },
      {
        "type": "select",
        "id": "button_hover_effect",
        "label": "悬停效果",
        "info": "触屏设备（手机、平板等）不支持悬停。",
        "options": [
          {
            "value": "none",
            "label": "无"
          },
          {
            "value": "fade",
            "label": "淡入淡出"
          },
          {
            "value": "reverse",
            "label": "反转样式"
          }
        ],
        "default": "fade"
      }
    ]
  },
