        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "显示货币代码",
        "default": false
      }
    ]
  },
  {
    "name": "动画",
    "settings": [
      {
        "type": "paragraph",
        "content": "已设置减少非必要动态效果的用户会自动看到减少后的动画。"
      },
      {
        "type": "checkbox",
        "id": "show_page_transition",
        "label": "显示页面过渡",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "zoom_image_on_hover",
        "label": "悬停时放大图片",
        "info": "多处图片会在悬停时放大。",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "stagger_products_apparition",
        "label": "逐个显示商品",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "reduce_drawer_animation",
        "label": "减少抽屉动画",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "reduce_menu_animation",
        "label": "减少页眉菜单动画",
        "default": false
      },
      {
        "type": "select",
        "id": "heading_apparition",
        "label": "标题出现动画",
        "info": "逐行出现动画不能用于渐变标题。[了解更多](https://support.maestrooo.com/article/299-limitation-for-gradients-on-impact-theme)",
        "options": [
          {
            "value": "none",
            "label": "无"
          },
          {
            "value": "fade",
            "label": "淡入淡出"
          },
          {
            "value": "split_fade",
            "label": "逐行显示，淡入"
          },
          {
            "value": "split_clip",
            "label": "逐行显示，裁切"
          },
          {
            "value": "split_rotation",
            "label": "逐行显示，旋转"
          }
        ],
        "default": "split_rotation"
      }
    ]
  },
