{{- 'case-customizer.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'case-customizer.js' | asset_url }}" defer="defer"></script>

<script id="{{ preview_map_id }}" type="application/json" data-custom-case-preview-map>
[
  {%- assign preview_blocks = section.blocks | where: 'type', 'case_preview_base' -%}
  {%- for preview_block in preview_blocks -%}
    {
      "option1Name": {{ preview_block.settings.option_name_1 | json }},
      "option1Value": {{ preview_block.settings.option_value_1 | json }},
      "option2Name": {{ preview_block.settings.option_name_2 | json }},
      "option2Value": {{ preview_block.settings.option_value_2 | json }},
      "label": {{ preview_block.settings.label | json }},
      "image": {%- if preview_block.settings.image != blank -%}{{ preview_block.settings.image | image_url: width: 1400 | json }}{%- else -%}""{%- endif -%}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
</script>

<section class="custom-case-page">
  <div class="custom-case-page__inner">
    <custom-case-flow
      data-form-id="{{ product_form_id | escape }}"
      data-product-url="{{ product.url | escape }}"
      data-preview-map-id="{{ preview_map_id | escape }}"
      data-default-base-image="{{ default_base_image_url | escape }}"
      data-default-base-label="{{ section.settings.default_base_label | escape }}"
      data-selection-error="{{ section.settings.selection_error_text | escape }}"
    >
      <div class="custom-case-page__top">
        <button type="button" class="custom-case-page__close" data-custom-case-exit aria-label="Back to product">×</button>
        <div class="custom-case-page__brand" aria-hidden="true">CASEEASE</div>
        <div class="custom-case-page__top-copy">
          {%- if section.settings.page_eyebrow != blank -%}
            <p class="custom-case-page__eyebrow">{{ section.settings.page_eyebrow | escape }}</p>
          {%- endif -%}
          <h1 class="custom-case-page__title">{{ section.settings.page_heading | default: product.title | escape }}</h1>
          {%- if section.settings.page_subheading != blank -%}
            <p class="custom-case-page__subtitle">{{ section.settings.page_subheading | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.page_badge != blank -%}
          <span class="custom-case-page__badge">{{ section.settings.page_badge | escape }}</span>
        {%- endif -%}
      </div>

      <div data-custom-case-view="configure">
        <div class="custom-case-config">
          <div class="custom-case-config__preview-card">
            <div class="custom-case-preview" data-custom-case-preview>
              <img class="custom-case-preview__image" data-custom-case-preview-image width="860" height="1200" alt="{{ section.settings.preview_alt | escape }}" hidden>
              <div class="custom-case-preview__fallback">{{ section.settings.preview_empty_text | escape }}</div>
            </div>

            <div class="custom-case-config__copy">
              {%- if section.settings.configure_eyebrow != blank -%}
                <p class="custom-case-page__step-eyebrow">{{ section.settings.configure_eyebrow | escape }}</p>
              {%- endif -%}
              <h2 class="custom-case-page__step-title">{{ section.settings.configure_heading | escape }}</h2>
              {%- if section.settings.configure_text != blank -%}
                <p class="custom-case-page__step-text">{{ section.settings.configure_text | escape }}</p>
              {%- endif -%}
              <div class="custom-case-selected" data-custom-case-selected-summary aria-live="polite"></div>
            </div>
          </div>

          <product-rerender id="custom-case-config-info-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}" allow-partial-rerender>
            <aside class="custom-case-panel">
              <div class="custom-case-page__title-wrap" data-block-type="title" data-block-id="custom-case-config-title">
                <h2 class="custom-case-page__product-title">{{ product.title }}</h2>
              </div>

              <div class="custom-case-page__price" data-block-type="price" data-block-id="custom-case-config-price">
                {%- render 'price-list', product: product, variant: selected_variant, size: 'lg' -%}
              </div>

              <div class="custom-case-page__divider"></div>

              <div class="custom-case-presteps">
                <div class="custom-case-prestep">
                  <div class="custom-case-prestep__heading">
                    <span>01.</span>
                    <strong>Templates</strong>
                  </div>
                  <div class="custom-case-prestep__chips">
                    <button type="button" class="is-selected">Sticker Studio</button>
                    <button type="button">Collage</button>
                    <button type="button">Cutouts</button>
                  </div>
                </div>

                <div class="custom-case-prestep">
                  <div class="custom-case-prestep__heading">
                    <span>02.</span>
                    <strong>Device Type</strong>
                  </div>
                  <div class="custom-case-prestep__chips">
                    <button type="button" class="is-selected">Phone Case</button>
                  </div>
                </div>
              </div>

              <div class="custom-case-page__variant-picker" data-block-type="variant-picker" data-block-id="custom-case-config-variant-picker">
                {%- render 'variant-picker',
                  product: product,
                  form_id: product_form_id,
                  update_url: true,
                  hide_sold_out_variants: section.settings.hide_sold_out_variants,
                  hide_size_chart: true,
                  force_color_variant_image: true,
                  context: 'main_product',
                  block: section
                -%}
              </div>

              <div data-block-type="liquid" data-block-id="custom-case-config-action">
                <button
                  type="button"
                  class="button custom-case-page__action-button"
                  data-custom-case-continue
                  {% unless selected_variant.available %}disabled{% endunless %}
                >
                  {%- if selected_variant.available -%}
                    {{ section.settings.continue_button_text | escape }}
                  {%- else -%}
                    {{ 'product.general.sold_out_button' | t }}
                  {%- endif -%}
                </button>
                <p class="custom-case-page__error" data-custom-case-error>{{ section.settings.selection_error_text | escape }}</p>
              </div>
            </aside>
          </product-rerender>
        </div>
      </div>

      <div data-custom-case-view="customize">
        <div class="custom-case-page__customize-top">
          <div>
            {%- if section.settings.customize_eyebrow != blank -%}
              <p class="custom-case-page__step-eyebrow">{{ section.settings.customize_eyebrow | escape }}</p>
            {%- endif -%}
            <h2 class="custom-case-page__step-title">{{ section.settings.customize_heading | escape }}</h2>
          </div>
          <button type="button" class="custom-case-page__back-button" data-custom-case-back>
            {{ section.settings.back_button_text | escape }}
          </button>
        </div>

        <div class="custom-case-page__grid">
          <div class="custom-case-page__studio">
            {%- render 'case-customizer',
              product: product,
              product_form_id: product_form_id,
              preview_map_id: preview_map_id,
              default_base_image: default_base_image_url,
              default_base_label: section.settings.default_base_label
            -%}
          </div>

          <product-rerender id="custom-case-customize-info-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}" allow-partial-rerender class="custom-case-page__summary">
            <aside class="custom-case-page__summary-card">
              <div class="custom-case-page__title-wrap" data-block-type="title" data-block-id="custom-case-customize-title">
                <h2 class="custom-case-page__product-title">{{ product.title }}</h2>
              </div>

              <div class="custom-case-selected" data-custom-case-selected-summary aria-live="polite"></div>

              <div class="custom-case-page__price" data-block-type="price" data-block-id="custom-case-customize-price">
                {%- render 'price-list', product: product, variant: selected_variant, size: 'lg' -%}
              </div>

              <div class="custom-case-page__divider"></div>

              {%- if section.settings.show_quantity_selector and product.available -%}
                <div class="custom-case-page__quantity" data-block-type="quantity-selector" data-block-id="custom-case-quantity">
                  <label for="{{ product_form_id }}-quantity" class="block-label text-subdued">{{- 'product.quantity.label' | t -}}:</label>
                  <quantity-selector class="quantity-selector">
                    <button type="button" tabindex="-1" class="quantity-selector__button" aria-label="{{ 'product.quantity.decrease_quantity' | t }}">{% render 'icon' with 'minus', width: 10, height: 2 %}</button>
                    <input id="{{ product_form_id }}-quantity" type="number" is="quantity-input" inputmode="numeric" class="quantity-selector__input" name="quantity" form="{{ product_form_id }}" value="{{ selected_variant.quantity_rule.min | default: 1 }}" step="{{ selected_variant.quantity_rule.increment }}" min="{{ selected_variant.quantity_rule.min }}" {% if selected_variant.quantity_rule.max != nil %}max="{{ selected_variant.quantity_rule.max }}"{% endif %} autocomplete="off">
                    <button type="button" tabindex="-1" class="quantity-selector__button" aria-label="{{ 'product.quantity.increase_quantity' | t }}">{% render 'icon' with 'plus', width: 10, height: 10 %}</button>
                  </quantity-selector>
                </div>
              {%- endif -%}

              <div class="custom-case-page__buy-buttons" data-block-type="buy-buttons" data-block-id="custom-case-buy-buttons">
                {%- render 'buy-buttons',
                  product: product,
                  form_id: product_form_id,
                  custom_case_add_to_cart: true,
                  custom_case_button_label: 'Add to cart',
                  show_payment_button: section.settings.show_payment_button,
                  show_gift_card_recipient: false,
                  atc_button_background: section.settings.atc_button_background,
                  atc_button_text_color: section.settings.atc_button_text_color,
                  payment_button_background: section.settings.payment_button_background,
                  payment_button_text_color: section.settings.payment_button_text_color,
                  show_payment_icons: section.settings.show_payment_icons
                -%}
              </div>

              {%- if section.settings.trust_text_1 != blank or section.settings.trust_text_2 != blank or section.settings.trust_text_3 != blank -%}
                <ul class="custom-case-page__trust">
                  {%- if section.settings.trust_text_1 != blank -%}
                    <li>{{ section.settings.trust_text_1 | escape }}</li>
                  {%- endif -%}
                  {%- if section.settings.trust_text_2 != blank -%}
                    <li>{{ section.settings.trust_text_2 | escape }}</li>
                  {%- endif -%}
                  {%- if section.settings.trust_text_3 != blank -%}
                    <li>{{ section.settings.trust_text_3 | escape }}</li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
            </aside>
          </product-rerender>
        </div>
      </div>
    </custom-case-flow>
  </div>
</section>

