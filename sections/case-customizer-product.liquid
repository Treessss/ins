{%- render 'section-spacing-collapsing' -%}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'custom-case-product-form-' | append: product.id | append: '-' | append: section.id
  assign preview_map_id = 'custom-case-preview-map-' | append: section.id
  assign default_base_image_url = ''

  if section.settings.default_base_image != blank
    assign default_base_image_url = section.settings.default_base_image | image_url: width: 1400
  elsif selected_variant.featured_media != blank
    assign default_base_image_url = selected_variant.featured_media | image_url: width: 1400
  elsif product.featured_media != blank
    assign default_base_image_url = product.featured_media | image_url: width: 1400
  endif
-%}

<script>
  document.documentElement.classList.toggle('custom-case-customizing', new URL(window.location.href).searchParams.get('customize') === '1');
</script>

<style>
  html:not(.custom-case-customizing) .shopify-section--case-customizer-product {
    display: none !important;
  }

  html.custom-case-customizing {
    background: #eeeeee;
  }

  html.custom-case-customizing body {
    min-height: 100vh;
    overflow-x: hidden;
    background: #eeeeee;
  }

  html.custom-case-customizing .shopify-section:not(.shopify-section--case-customizer-product) {
    display: none !important;
  }

  html.custom-case-customizing .shopify-section--case-customizer-product {
    display: block !important;
  }

  #shopify-section-{{ section.id }} {
    --custom-case-bg: {{ section.settings.background | default: '#f4f4f2' }};
    --custom-case-text: {{ section.settings.text_color | default: '#111111' }};
    --custom-case-muted: #636363;
    --custom-case-card: #fff;
    --custom-case-border: #dfdfdf;
  }

  #shopify-section-{{ section.id }} .custom-case-page {
    min-height: 100vh;
    color: var(--custom-case-text);
    background: var(--custom-case-bg);
  }

  #shopify-section-{{ section.id }} .custom-case-page__inner {
    width: min(100%, 1480px);
    margin-inline: auto;
    padding: clamp(14px, 2vw, 28px);
  }

  #shopify-section-{{ section.id }} .custom-case-page__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: end;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .custom-case-page__eyebrow,
  #shopify-section-{{ section.id }} .custom-case-page__step-eyebrow {
    margin: 0 0 8px;
    color: var(--custom-case-muted);
    font-family: "Gotham-Bold", var(--heading-font-family), sans-serif;
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .custom-case-page__title {
    max-width: 820px;
    margin: 0;
    color: #000;
    font-family: "Gotham-Bold", var(--heading-font-family), sans-serif;
    font-size: clamp(38px, 5vw, 76px);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .custom-case-page__subtitle {
    max-width: 720px;
    margin: 12px 0 0;
    color: var(--custom-case-muted);
    font-size: clamp(15px, 1.35vw, 19px);
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .custom-case-page__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0 14px;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font-family: "Gotham-Bold", var(--heading-font-family), sans-serif;
    font-size: 13px;
    font-weight: 400;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .custom-case-page__close,
  #shopify-section-{{ section.id }} .custom-case-page__brand {
    display: none;
  }

  #shopify-section-{{ section.id }} custom-case-flow {
    display: block;
  }

  #shopify-section-{{ section.id }} [data-custom-case-view] {
    display: none;
  }

  #shopify-section-{{ section.id }} custom-case-flow.is-configuring [data-custom-case-view="configure"],
  #shopify-section-{{ section.id }} custom-case-flow.is-customizing [data-custom-case-view="customize"] {
    display: block;
  }

  #shopify-section-{{ section.id }} .custom-case-config {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 460px);
    gap: clamp(14px, 2vw, 24px);
    align-items: start;
  }

  #shopify-section-{{ section.id }} .custom-case-config__preview-card,
  #shopify-section-{{ section.id }} .custom-case-panel,
  #shopify-section-{{ section.id }} .custom-case-page__studio,
  #shopify-section-{{ section.id }} .custom-case-page__summary-card {
    border-radius: 28px;
    background: var(--custom-case-card);
    box-shadow: 0 12px 16px 0 #6b6f7314;
  }

  #shopify-section-{{ section.id }} .custom-case-config__preview-card {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1fr);
    gap: clamp(16px, 2vw, 28px);
    align-items: center;
    min-height: 620px;
    padding: clamp(16px, 2.3vw, 32px);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .custom-case-preview {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 430px);
    aspect-ratio: 0.72;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid #e7e7e7;
    border-radius: 36px;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 92%), rgb(245 245 245 / 92%)),
      repeating-linear-gradient(45deg, #eeeeee 0 8px, #f8f8f8 8px 16px);
  }

  #shopify-section-{{ section.id }} .custom-case-preview::before {
    content: "";
    position: absolute;
    inset: 7% 18%;
    border: 10px solid #111;
    border-radius: 42px;
    box-shadow: 0 28px 45px rgb(0 0 0 / 12%);
    pointer-events: none;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .custom-case-preview::after {
    content: "";
    position: absolute;
    top: 11%;
    left: 23%;
    width: 74px;
    height: 74px;
    border: 6px solid #111;
    border-radius: 22px;
    background: #f7f7f7;
    box-shadow:
      14px 14px 0 -6px #111,
      38px 14px 0 -9px #111,
      14px 40px 0 -9px #111;
    pointer-events: none;
    z-index: 3;
  }

  #shopify-section-{{ section.id }} .custom-case-preview__image {
    position: absolute;
    inset: 7% 18%;
    width: 64%;
    height: 86%;
    object-fit: cover;
    border-radius: 38px;
  }

  #shopify-section-{{ section.id }} .custom-case-preview__fallback {
    position: absolute;
    inset: 7% 18%;
    display: grid;
    place-items: center;
    padding: 24px;
    border-radius: 38px;
    background: linear-gradient(160deg, #fbfbfb, #e8e8e8);
    color: #777;
    font-size: 13px;
    line-height: 1.35;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .custom-case-preview.has-image .custom-case-preview__fallback {
    display: none;
  }

  #shopify-section-{{ section.id }} .custom-case-config__copy {
    display: grid;
    gap: 18px;
    align-content: center;
  }

  #shopify-section-{{ section.id }} .custom-case-page__step-title {
    margin: 0;
    color: #000;
    font-family: "Gotham-Bold", var(--heading-font-family), sans-serif;
    font-size: clamp(30px, 4vw, 56px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .custom-case-page__step-text {
    max-width: 52ch;
    margin: 0;
    color: var(--custom-case-muted);
    font-size: 16px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .custom-case-selected {
    display: grid;
    gap: 8px;
    padding: 14px;
    border: 1px solid var(--custom-case-border);
    border-radius: 18px;
    background: #f8f8f7;
  }

  #shopify-section-{{ section.id }} .custom-case-selected__row {
    display: grid;
    grid-template-columns: minmax(88px, auto) minmax(0, 1fr);
    gap: 10px;
    color: #111;
    font-size: 13px;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .custom-case-selected__label {
    color: #777;
  }

  #shopify-section-{{ section.id }} .custom-case-panel {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 18px;
    padding: 22px;
  }

  #shopify-section-{{ section.id }} .custom-case-page__product-title {
    margin: 0;
    color: #000;
    font-family: "Gotham-Bold", var(--heading-font-family), sans-serif;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .custom-case-page__price .price-list {
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .custom-case-page__price sale-price,
  #shopify-section-{{ section.id }} .custom-case-page__price compare-at-price {
    font-size: 24px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .custom-case-page__divider {
    height: 1px;
    background: #e8e8e8;
  }

  #shopify-section-{{ section.id }} .custom-case-page__variant-picker .variant-picker {
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .custom-case-page__action-button,
  #shopify-section-{{ section.id }} .custom-case-page__buy-buttons .button {
    width: 100%;
    min-height: 54px;
    border-radius: 999px;
    background: linear-gradient(180deg, #303030 0%, #0b0b0b 100%) !important;
    color: #fff !important;
    border: 1px solid #000;
    box-shadow: inset 0 2px 10px rgb(255 255 255 / 12%);
    font-family: "Gotham-Bold", var(--heading-font-family), sans-serif;
    font-size: 18px;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .custom-case-page__action-button[disabled] {
    cursor: not-allowed;
    opacity: 0.45;
  }

  #shopify-section-{{ section.id }} .custom-case-page__error {
    display: none;
    margin: -6px 0 0;
    color: #9b1c1c;
    font-size: 13px;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} custom-case-flow.has-selection-error .custom-case-page__error {
    display: block;
  }

  #shopify-section-{{ section.id }} .custom-case-page__customize-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .custom-case-page__back-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid #d7d7d7;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font-family: "Gotham-Bold", var(--heading-font-family), sans-serif;
    font-size: 13px;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .custom-case-page__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 420px);
    gap: clamp(14px, 2vw, 24px);
    align-items: start;
  }

  #shopify-section-{{ section.id }} .custom-case-page__studio,
  #shopify-section-{{ section.id }} .custom-case-page__summary-card {
    padding: clamp(14px, 1.6vw, 22px);
  }

  #shopify-section-{{ section.id }} .custom-case-page__summary-card {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .custom-case-page__buy-buttons .buy-buttons {
    display: block;
  }

  #shopify-section-{{ section.id }} .custom-case-page__trust {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .custom-case-page__trust li {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #555;
    font-size: 13px;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .custom-case-page__trust li::before {
    content: "";
    flex: 0 0 8px;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #111;
  }

  #shopify-section-{{ section.id }} .custom-case-page__quantity {
    display: grid;
    gap: 8px;
  }

  @media screen and (max-width: 1099px) {
    #shopify-section-{{ section.id }} .custom-case-config,
    #shopify-section-{{ section.id }} .custom-case-page__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    #shopify-section-{{ section.id }} .custom-case-panel,
    #shopify-section-{{ section.id }} .custom-case-page__summary-card {
      position: static;
    }
  }

  @media screen and (max-width: 899px) {
    #shopify-section-{{ section.id }} .custom-case-config__preview-card {
      grid-template-columns: minmax(0, 1fr);
      min-height: auto;
    }

    #shopify-section-{{ section.id }} .custom-case-preview {
      max-width: 360px;
    }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .custom-case-page__top {
      grid-template-columns: minmax(0, 1fr);
    }

    #shopify-section-{{ section.id }} .custom-case-page__inner {
      padding: 12px;
    }

    #shopify-section-{{ section.id }} .custom-case-config__preview-card,
    #shopify-section-{{ section.id }} .custom-case-panel,
    #shopify-section-{{ section.id }} .custom-case-page__studio,
    #shopify-section-{{ section.id }} .custom-case-page__summary-card {
      padding: 16px;
      border-radius: 22px;
    }

    #shopify-section-{{ section.id }} .custom-case-page__product-title {
      font-size: 25px;
    }
  }

  /*
    Studio layout inspired by CASETiFY: compact product header, step rail on the side,
    and a large neutral preview stage. Kept here so the dedicated template stays self-contained.
  */
  #shopify-section-{{ section.id }} .custom-case-page {
    background: #f2f2f2;
  }

  #shopify-section-{{ section.id }} .custom-case-page__inner {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .custom-case-page__top {
    position: sticky;
    top: 0;
    z-index: 12;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    min-height: 74px;
    margin: 0;
    padding: 12px clamp(16px, 2vw, 28px);
    border-bottom: 1px solid #dedede;
    background: rgb(255 255 255 / 96%);
    backdrop-filter: blur(12px);
  }

  #shopify-section-{{ section.id }} .custom-case-page__eyebrow {
    margin: 0 0 4px;
    color: #747474;
    font-size: 11px;
  }

  #shopify-section-{{ section.id }} .custom-case-page__title {
    max-width: none;
    font-size: 22px;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .custom-case-page__subtitle {
    max-width: 680px;
    margin-top: 4px;
    color: #6b6b6b;
    font-size: 13px;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .custom-case-page__badge {
    min-height: 34px;
    padding-inline: 14px;
    background: #111;
    font-size: 12px;
  }

  #shopify-section-{{ section.id }} .custom-case-config {
    display: grid;
    grid-template-columns: minmax(340px, 430px) minmax(0, 1fr);
    gap: 0;
    min-height: calc(100vh - 74px);
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .custom-case-config > product-rerender {
    order: 1;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .custom-case-config__preview-card {
    order: 2;
    position: sticky;
    top: 74px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    justify-items: center;
    min-height: calc(100vh - 74px);
    padding: 34px;
    border-left: 1px solid #dedede;
    border-radius: 0;
    background:
      radial-gradient(circle at 50% 18%, #ffffff 0 0, transparent 280px),
      linear-gradient(180deg, #f7f7f7 0%, #eeeeee 100%);
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .custom-case-config__preview-card::after {
    content: "01/02";
    position: absolute;
    right: 26px;
    bottom: 22px;
    min-width: 54px;
    padding: 7px 10px;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font-family: "Gotham-Bold", var(--heading-font-family), sans-serif;
    font-size: 12px;
    line-height: 1;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .custom-case-preview {
    width: min(48vh, 390px);
    min-width: 280px;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .custom-case-preview::before {
    inset: 5% 16%;
    border-width: 11px;
    border-radius: 48px;
    box-shadow: 0 30px 60px rgb(0 0 0 / 18%);
  }

  #shopify-section-{{ section.id }} .custom-case-preview::after {
    top: 9%;
    left: 21%;
    width: 82px;
    height: 82px;
    border-width: 7px;
    border-radius: 24px;
  }

  #shopify-section-{{ section.id }} .custom-case-preview__image,
  #shopify-section-{{ section.id }} .custom-case-preview__fallback {
    inset: 5% 16%;
    width: 68%;
    height: 90%;
    border-radius: 44px;
  }

  #shopify-section-{{ section.id }} .custom-case-config__copy {
    position: absolute;
    left: 26px;
    bottom: 22px;
    max-width: min(360px, calc(100% - 120px));
    gap: 8px;
    padding: 14px 16px;
    border: 1px solid rgb(255 255 255 / 70%);
    border-radius: 18px;
    background: rgb(255 255 255 / 82%);
    backdrop-filter: blur(12px);
    box-shadow: 0 14px 28px rgb(0 0 0 / 8%);
  }

  #shopify-section-{{ section.id }} .custom-case-page__step-eyebrow {
    margin: 0;
    color: #777;
    font-size: 11px;
  }

  #shopify-section-{{ section.id }} .custom-case-page__step-title {
    font-size: 24px;
    line-height: 1.05;
  }

  #shopify-section-{{ section.id }} .custom-case-page__step-text {
    max-width: none;
    font-size: 13px;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .custom-case-panel,
  #shopify-section-{{ section.id }} .custom-case-page__studio,
  #shopify-section-{{ section.id }} .custom-case-page__summary-card {
    border-radius: 0;
    background: #fff;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .custom-case-panel {
    position: sticky;
    top: 74px;
    align-content: start;
    min-height: calc(100vh - 74px);
    max-height: calc(100vh - 74px);
    overflow-y: auto;
    padding: 24px;
    border-right: 1px solid #dedede;
  }

  #shopify-section-{{ section.id }} .custom-case-page__product-title {
    font-size: 22px;
    line-height: 1.14;
  }

  #shopify-section-{{ section.id }} .custom-case-page__price sale-price,
  #shopify-section-{{ section.id }} .custom-case-page__price compare-at-price {
    font-size: 18px;
  }

  #shopify-section-{{ section.id }} .custom-case-page__variant-picker .variant-picker {
    counter-reset: custom-case-option 2;
    gap: 0;
    border-top: 1px solid #e5e5e5;
  }

  #shopify-section-{{ section.id }} .custom-case-presteps {
    display: grid;
    gap: 0;
    border-top: 1px solid #e5e5e5;
  }

  #shopify-section-{{ section.id }} .custom-case-prestep {
    display: grid;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid #e5e5e5;
  }

  #shopify-section-{{ section.id }} .custom-case-prestep__heading {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #111;
    font-family: "Gotham-Bold", var(--heading-font-family), sans-serif;
    font-size: 14px;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .custom-case-prestep__heading span {
    color: #777;
  }

  #shopify-section-{{ section.id }} .custom-case-prestep__chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .custom-case-prestep__chips button {
    min-height: 42px;
    padding: 0 12px;
    border: 1px solid #dedede;
    border-radius: 16px;
    background: #fafafa;
    color: #111;
    font-family: "Gotham-Bold", var(--heading-font-family), sans-serif;
    font-size: 12px;
    line-height: 1.1;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .custom-case-prestep__chips button.is-selected {
    border-color: #111;
    box-shadow: inset 0 0 0 1px #111;
  }

  #shopify-section-{{ section.id }} .custom-case-page__variant-picker .variant-picker__option {
    counter-increment: custom-case-option;
    display: grid;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid #e5e5e5;
  }

  #shopify-section-{{ section.id }} .custom-case-page__variant-picker .variant-picker__option-info {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .custom-case-page__variant-picker legend {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #111;
    font-family: "Gotham-Bold", var(--heading-font-family), sans-serif;
    font-size: 14px;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .custom-case-page__variant-picker legend::before {
    content: counter(custom-case-option, decimal-leading-zero) ".";
    color: #777;
  }

