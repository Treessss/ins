      padding-block: 2px;
    }

    #shopify-section-{{ section.id }} .xstrape-header__announcement-link {
      flex-wrap: wrap;
      max-width: 100%;
    }
  }
</style>

<div class="xstrape-header" data-xstrape-header>
  {%- if section.settings.show_announcement and section.settings.announcement_text != blank -%}
    <div class="xstrape-header__announcement">
      <a class="xstrape-header__announcement-link" {% if section.settings.announcement_link != blank %}href="{{ section.settings.announcement_link }}"{% endif %}>
        <span>{{ section.settings.announcement_text | escape }}</span>
        {%- if section.settings.announcement_link_text != blank -%}
          <span aria-hidden="true">|</span>
          <span class="xstrape-header__announcement-cta">{{ section.settings.announcement_link_text | escape }}</span>
        {%- endif -%}
        {%- if section.settings.show_announcement_info_icon -%}
          <span class="xstrape-header__announcement-info" aria-hidden="true">i</span>
        {%- endif -%}
      </a>
    </div>
  {%- endif -%}

    <div class="xstrape-header__bar" data-xstrape-header-bar>
      {%- capture logo_content -%}
        {%- if section.settings.logo != blank -%}
        {%- assign logo_desktop_width = section.settings.logo_width | default: 150 -%}
        {%- assign logo_mobile_width = section.settings.logo_mobile_width | default: logo_desktop_width -%}
        {%- assign logo_desktop_render_width = logo_desktop_width | times: 2 -%}
        {%- assign logo_mobile_render_width = logo_mobile_width | times: 2 -%}
        {%- assign logo_render_width = logo_desktop_render_width | at_least: logo_mobile_render_width | at_least: 220 | at_most: 360 -%}
        {%- assign logo_sizes = '(max-width: 699px) ' | append: logo_mobile_width | append: 'px, ' | append: logo_desktop_width | append: 'px' -%}
        {%- assign logo_alt = section.settings.logo.alt | default: section.settings.logo_text | default: shop.name -%}
        {{ section.settings.logo | image_url: width: logo_render_width | image_tag: loading: 'eager', class: 'xstrape-header__logo-image', alt: logo_alt, sizes: logo_sizes, widths: '110,150,220,300,360' }}
      {%- else -%}
        <span class="xstrape-header__logo-text">{{ section.settings.logo_text | default: shop.name | escape }}</span>
      {%- endif -%}
    {%- endcapture -%}

    {%- if request.page_type == 'index' -%}
      <h1 class="xstrape-header__logo">
        <a class="xstrape-header__logo-link" href="{{ routes.root_url }}">{{ logo_content }}</a>
      </h1>
    {%- else -%}
      <div class="xstrape-header__logo">
        <a class="xstrape-header__logo-link" href="{{ routes.root_url }}">{{ logo_content }}</a>
      </div>
    {%- endif -%}

    <nav class="xstrape-header__nav" aria-label="{{ section.settings.desktop_menu_label | escape }}">
      <ul class="xstrape-header__nav-list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'desktop_item' -%}
            {%- liquid
              assign item_url = block.settings.link
              assign has_dropdown = block.settings.enable_dropdown
              assign has_link_columns = false
              assign link_column_count = 0
              assign largest_link_count = 0
              assign desktop_item_title_handle = block.settings.title | handleize
              assign desktop_card_columns = block.settings.desktop_card_columns | default: 1 | plus: 0
              assign desktop_card_count = 0
              assign feature_image_asset = block.settings.feature_image_asset | strip
              assign has_feature_card = false
              assign has_dropdown_content = false
              assign is_simple_dropdown = false

              if desktop_card_columns < 1
                assign desktop_card_columns = 1
              elsif desktop_card_columns > 4
                assign desktop_card_columns = 4
              endif

              assign desktop_card_track_min = desktop_card_columns | times: 240
              if desktop_card_track_min < 330
                assign desktop_card_track_min = 330
              elsif desktop_card_track_min > 900
                assign desktop_card_track_min = 900
              endif

              if block.settings.feature_image != blank or feature_image_asset != blank
                assign has_feature_card = true
              endif

              for card_block in section.blocks
                assign card_parent_handle = card_block.settings.parent_title | handleize
                if card_block.type == 'desktop_menu_card' and card_block.settings.title != blank and card_parent_handle == desktop_item_title_handle
                  assign desktop_card_count = desktop_card_count | plus: 1
                endif
              endfor

              for index in (1..3)
                assign list_key = 'link_list_' | append: index
                assign link_list = block.settings[list_key]
                if link_list != blank and link_list.links.size > 0
                  assign has_link_columns = true
                  assign link_column_count = link_column_count | plus: 1
                  if link_list.links.size > largest_link_count
                    assign largest_link_count = link_list.links.size
                  endif
                endif
              endfor

              if has_dropdown and has_link_columns and desktop_card_count == 0 and has_feature_card == false
                assign is_simple_dropdown = true
              endif

              if has_link_columns or desktop_card_count > 0 or has_feature_card
                assign has_dropdown_content = true
              endif

              assign simple_menu_width = link_column_count | times: 210 | plus: 112
              if largest_link_count > 8 and link_column_count == 1
                assign simple_menu_width = 560
              elsif simple_menu_width < 320
                assign simple_menu_width = 320
              elsif simple_menu_width > 760
                assign simple_menu_width = 760
              endif
            -%}

            <li class="xstrape-header__nav-item" {{ block.shopify_attributes }}>
              {%- if has_dropdown and has_dropdown_content -%}
                <div class="xstrape-header__nav-item" data-xstrape-mega-item>
                  {%- capture desktop_menu_label -%}
                    {%- if block.settings.split_title -%}
                      {{ block.settings.title | escape | replace: ' ', '<br>' }}
                    {%- else -%}
                      {{ block.settings.title | escape }}
                    {%- endif -%}
                  {%- endcapture -%}

                  {%- if item_url != blank -%}
                    <a class="xstrape-header__nav-summary" href="{{ item_url }}" aria-haspopup="true" aria-expanded="false" data-xstrape-mega-trigger>
                      {{ desktop_menu_label }}
                    </a>
                  {%- else -%}
                    <button class="xstrape-header__nav-summary" type="button" aria-haspopup="true" aria-expanded="false" data-xstrape-mega-trigger>
                      {{ desktop_menu_label }}
                    </button>
                  {%- endif -%}

                  <div class="xstrape-header__mega-panel {% if is_simple_dropdown %}xstrape-header__mega-panel--simple{% endif %}" {% if is_simple_dropdown %}style="--xstrape-header-simple-menu-width: {{ simple_menu_width }}px; --xstrape-header-simple-link-columns: {{ link_column_count }};"{% endif %}>
                    <div class="xstrape-header__mega-inner {% unless has_link_columns %}xstrape-header__mega-inner--no-links{% endunless %} {% unless has_feature_card %}xstrape-header__mega-inner--no-feature{% endunless %} {% if desktop_card_count == 0 %}xstrape-header__mega-inner--no-cards{% endif %}" style="--xstrape-header-card-columns: {{ desktop_card_columns }}; --xstrape-header-card-track-min: {{ desktop_card_track_min }}px;">
                      <ul class="xstrape-header__mega-cards" role="list">
                        {%- for card_block in section.blocks -%}
                          {%- liquid
                            assign card_parent_handle = card_block.settings.parent_title | handleize
                            assign card_image_asset = card_block.settings.image_asset | strip
                            assign card_badge = card_block.settings.badge
                            assign card_badge_normalized = card_badge | upcase
                            assign card_badge_style = 'new'
                            if card_badge_normalized contains 'HOT'
                              assign card_badge_style = 'hot'
                            elsif card_badge_normalized contains 'SALE' or card_badge_normalized contains 'FEATURED'
                              assign card_badge_style = 'sale'
                            endif
                          -%}

                          {%- if card_block.type == 'desktop_menu_card' and card_block.settings.title != blank and card_parent_handle == desktop_item_title_handle -%}
                            <li {{ card_block.shopify_attributes }}>
                              <a class="xstrape-header__mega-card" {% if card_block.settings.link != blank %}href="{{ card_block.settings.link }}"{% elsif item_url != blank %}href="{{ item_url }}"{% endif %}>
                                <span class="xstrape-header__thumb {% if card_block.settings.image == blank and card_image_asset == blank %}xstrape-header__thumb--placeholder{% endif %}">
                                  {%- if card_block.settings.image != blank -%}
                                    {{ card_block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', sizes: '76px' }}
                                  {%- elsif card_image_asset != blank -%}
                                    <img src="{{ card_image_asset | asset_url }}" alt="" loading="lazy" width="76" height="76">
                                  {%- endif -%}
                                </span>
                                <span>
                                  <span class="xstrape-header__mega-title">
                                    {{ card_block.settings.title | escape }}
                                    {%- if card_badge != blank -%}
                                      <span class="xstrape-header__badge xstrape-header__badge--{{ card_badge_style }}">{{ card_badge | escape }}</span>
                                    {%- endif -%}
                                  </span>
                                  {%- if card_block.settings.text != blank -%}
                                    <span class="xstrape-header__mega-text">{{ card_block.settings.text | escape }}</span>
                                  {%- endif -%}
                                </span>
                                <span class="xstrape-header__arrow" aria-hidden="true">&rsaquo;</span>
                              </a>
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>

                      {%- if has_link_columns -%}
                        <div class="xstrape-header__mega-link-grid xstrape-header__mega-link-grid--columns-{{ link_column_count }} {% if link_column_count == 1 and largest_link_count > 8 %}xstrape-header__mega-link-grid--single{% endif %}">
                          {%- for index in (1..3) -%}
                            {%- liquid
                              assign heading_key = 'link_heading_' | append: index
                              assign list_key = 'link_list_' | append: index
                              assign link_list = block.settings[list_key]
                              assign heading = block.settings[heading_key] | default: link_list.title
                            -%}
                            {%- if link_list != blank and link_list.links.size > 0 -%}
                              <div class="xstrape-header__mega-link-column">
                                <p class="xstrape-header__mega-heading">{{ heading | escape }}</p>
                                <ul class="xstrape-header__mega-links" role="list">
                                  {%- for link in link_list.links -%}
                                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                                  {%- endfor -%}
                                </ul>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      {%- endif -%}

                      {%- if has_feature_card -%}
                        <a class="xstrape-header__feature" {% if block.settings.feature_link != blank %}href="{{ block.settings.feature_link }}"{% elsif item_url != blank %}href="{{ item_url }}"{% endif %}>
                          {%- if block.settings.feature_image != blank -%}
                            {{ block.settings.feature_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '280px' }}
                          {%- elsif feature_image_asset != blank -%}
                            <img src="{{ feature_image_asset | asset_url }}" alt="" loading="lazy" width="700" height="700">
                          {%- endif -%}
                          <span class="xstrape-header__feature-body">
                            {%- if block.settings.feature_kicker != blank -%}
                              <span class="xstrape-header__feature-kicker">{{ block.settings.feature_kicker | escape }}</span>
                            {%- endif -%}
                            <span class="xstrape-header__feature-title">{{ block.settings.feature_title | default: block.settings.title | escape }}</span>
                            {%- if block.settings.feature_button_text != blank -%}
                              <span class="xstrape-header__feature-cta">{{ block.settings.feature_button_text | escape }}</span>
                            {%- endif -%}
                          </span>
                        </a>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- else -%}
                <a class="xstrape-header__nav-link {% if block.settings.highlight %}xstrape-header__nav-link--highlight{% endif %}" {% if item_url != blank %}href="{{ item_url }}"{% endif %}>
                  {%- if block.settings.split_title -%}
                    {{ block.settings.title | escape | replace: ' ', '<br>' }}
                  {%- else -%}
                    {{ block.settings.title | escape }}
                  {%- endif -%}
                </a>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <ul class="xstrape-header__actions" role="list">
      {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
        <li class="xstrape-header__desktop-only">
          {%- render 'localization-selector', type: 'country', show_country_name: section.settings.show_country_name, show_country_flag: section.settings.show_country_flag, popover_vertical_position: 'end' -%}
        </li>
      {%- endif -%}

      {%- if section.settings.show_search -%}
        <li>
          <a class="xstrape-header__icon" href="{{ routes.search_url }}" aria-controls="search-drawer">
            <span class="sr-only">{{ 'header.general.search' | t }}</span>
            {%- render 'icon' with 'search' -%}
          </a>
        </li>
      {%- endif -%}

      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <li class="xstrape-header__desktop-only">
          <shopify-account menu="{{ section.settings.customer_account_menu }}">
            <div slot="signed-out-avatar" class="xstrape-header__icon">
              <span class="sr-only">{{ 'header.general.login' | t }}</span>
              {%- render 'icon' with 'account' -%}
            </div>
          </shopify-account>
        </li>
      {%- endif -%}

      {%- if section.settings.show_cart -%}
        <li>
          <a class="xstrape-header__icon" href="{{ routes.cart_url }}" data-no-instant {% if settings.cart_type != 'page' and request.page_type != 'cart' %}aria-controls="cart-drawer"{% endif %}>
            <span class="sr-only">{{ 'header.general.cart' | t }}</span>
            {%- render 'icon' with 'cart' -%}
            <cart-count class="xstrape-header__cart-count {% if cart.item_count == 0 %}is-empty{% endif %}" aria-hidden="true">{{ cart.item_count }}</cart-count>
          </a>
        </li>
      {%- endif -%}

      <li class="xstrape-header__mobile-only">
        <button class="xstrape-header__icon" type="button" aria-controls="xstrape-mobile-panel-{{ section.id }}" aria-expanded="false" data-xstrape-mobile-menu-toggle>
          <span class="sr-only">{{ 'header.general.menu' | t }}</span>
          <span class="xstrape-header__menu-open">{%- render 'icon' with 'hamburger' -%}</span>
          <span class="xstrape-header__menu-close">{%- render 'icon' with 'close', width: 25, height: 25 -%}</span>
        </button>
      </li>
    </ul>
  </div>

  <div id="xstrape-mobile-panel-{{ section.id }}" class="xstrape-header__mobile-panel" hidden>
    <button class="xstrape-header__mobile-scrim" type="button" aria-label="{{ 'general.accessibility.close' | t | escape }}" data-xstrape-mobile-menu-close></button>
    <div class="xstrape-header__mobile-surface" role="dialog" aria-modal="true" aria-label="{{ 'header.general.menu' | t | escape }}" tabindex="-1">
      <div class="xstrape-header__mobile-level" data-xstrape-mobile-main>
        <ul class="xstrape-header__mobile-list" role="list">
          {%- assign has_mobile_cards = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'mobile_card' -%}
              {%- assign has_mobile_cards = true -%}
              {%- liquid
                assign has_submenu = false
                assign auto_submenu_menu = block.settings.auto_submenu_menu
                assign mobile_card_title_handle = block.settings.title | handleize
                if auto_submenu_menu != blank and auto_submenu_menu.links.size > 0
                  assign has_submenu = true
                endif
                for submenu_block in section.blocks
                  if submenu_block.type == 'mobile_submenu_item'
                    assign submenu_parent_handle = submenu_block.settings.parent_title | handleize
                    if submenu_block.settings.title != blank and submenu_parent_handle == mobile_card_title_handle
                      assign has_submenu = true
                    endif
                  endif
                endfor

                assign mobile_image_asset = block.settings.image_asset | strip
                if mobile_image_asset == blank
                  assign mobile_image_asset = blank
                endif
              -%}

              {%- capture mobile_card_inner -%}
                <span class="xstrape-header__mobile-thumb {% if block.settings.image == blank and mobile_image_asset == blank %}xstrape-header__mobile-thumb--placeholder{% endif %}">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', sizes: '74px' }}
                  {%- elsif mobile_image_asset != blank -%}
                    <img src="{{ mobile_image_asset | asset_url }}" alt="" loading="lazy" width="74" height="74">
                  {%- endif -%}
                </span>
                <span class="xstrape-header__mobile-body">
                  <span class="xstrape-header__mobile-title">
                    {{ block.settings.title | escape }}
                    {%- if block.settings.badge != blank -%}
                      <span class="xstrape-header__badge xstrape-header__badge--{{ block.settings.badge_style }}">{{ block.settings.badge | escape }}</span>
                    {%- endif -%}
                  </span>
                  {%- if block.settings.subtitle != blank -%}
                    <span class="xstrape-header__mobile-text">{{ block.settings.subtitle | escape }}</span>
                  {%- endif -%}
                </span>
                <span class="xstrape-header__mobile-arrow" aria-hidden="true">&rsaquo;</span>
              {%- endcapture -%}

              <li {{ block.shopify_attributes }}>
                {%- if has_submenu -%}
                  <button class="xstrape-header__mobile-card" type="button" aria-controls="xstrape-mobile-submenu-{{ section.id }}-{{ block.id }}" data-xstrape-mobile-submenu-open="{{ block.id }}">
                    {{ mobile_card_inner }}
                  </button>
                {%- else -%}
                  <a class="xstrape-header__mobile-card" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}>
                    {{ mobile_card_inner }}
                  </a>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}

          {%- unless has_mobile_cards -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'desktop_item' -%}
                <li>
                  <a class="xstrape-header__mobile-card" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}>
                    <span class="xstrape-header__mobile-thumb xstrape-header__mobile-thumb--placeholder"></span>
                    <span class="xstrape-header__mobile-body">
                      <span class="xstrape-header__mobile-title">{{ block.settings.title | escape }}</span>
                    </span>
                    <span class="xstrape-header__mobile-arrow" aria-hidden="true">&rsaquo;</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endunless -%}
        </ul>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'mobile_card' -%}
          {%- liquid
            assign has_submenu = false
            assign auto_submenu_menu = block.settings.auto_submenu_menu
            assign mobile_card_title_handle = block.settings.title | handleize
            if auto_submenu_menu != blank and auto_submenu_menu.links.size > 0
              assign has_submenu = true
            endif
            for submenu_block in section.blocks
              if submenu_block.type == 'mobile_submenu_item'
                assign submenu_parent_handle = submenu_block.settings.parent_title | handleize
                if submenu_block.settings.title != blank and submenu_parent_handle == mobile_card_title_handle
                  assign has_submenu = true
                endif
              endif
            endfor
          -%}

          {%- if has_submenu -%}
            <div id="xstrape-mobile-submenu-{{ section.id }}-{{ block.id }}" class="xstrape-header__mobile-level" data-xstrape-mobile-submenu="{{ block.id }}" hidden>
              <div class="xstrape-header__mobile-subhead">
                <button class="xstrape-header__mobile-back" type="button" aria-label="返回上一级菜单" data-xstrape-mobile-submenu-back></button>
                <p class="xstrape-header__mobile-subheading">{{ block.settings.title | escape }}</p>
              </div>
              <ul class="xstrape-header__mobile-list xstrape-header__mobile-sublist" role="list">
                {%- liquid
                  assign mobile_card_title_handle = block.settings.title | handleize
                  assign auto_submenu_menu = block.settings.auto_submenu_menu
                -%}

                {%- if auto_submenu_menu != blank and auto_submenu_menu.links.size > 0 -%}
                  {%- for auto_link in auto_submenu_menu.links -%}
                    {%- liquid
                      assign auto_child_image = blank
                      if auto_link.object != blank
                        case auto_link.type
                          when 'collection_link'
                            assign auto_child_image = auto_link.object.image
                            if auto_child_image == blank
                              assign auto_child_image = auto_link.object.featured_image
                            endif
                            if auto_child_image == blank
                              assign auto_child_image = auto_link.object.products.first.featured_media
                            endif
                          when 'product_link'
                            assign auto_child_image = auto_link.object.featured_media
                          when 'blog_link'
                            assign auto_child_image = auto_link.object.articles.first.image
                          when 'article_link'
                            assign auto_child_image = auto_link.object.image
                        endcase
                      endif
                    -%}
                    <li>
                      <a class="xstrape-header__mobile-card" href="{{ auto_link.url }}">
                        <span class="xstrape-header__mobile-thumb {% if auto_child_image == blank %}xstrape-header__mobile-thumb--placeholder{% endif %}">
                          {%- if auto_child_image != blank -%}
                            {{ auto_child_image | image_url: width: 320 | image_tag: loading: 'lazy', sizes: '74px', alt: auto_link.title }}
                          {%- endif -%}
                        </span>
                        <span class="xstrape-header__mobile-body">
                          <span class="xstrape-header__mobile-title">
                            {{ auto_link.title | escape }}
                          </span>
                        </span>
                        <span class="xstrape-header__mobile-arrow" aria-hidden="true">&rsaquo;</span>
                      </a>
                    </li>
                  {%- endfor -%}
                {%- endif -%}

                {%- for submenu_block in section.blocks -%}
                  {%- liquid
                    assign is_matching_submenu_item = false
                    assign submenu_parent_handle = submenu_block.settings.parent_title | handleize
                    if submenu_block.type == 'mobile_submenu_item' and submenu_block.settings.title != blank
                      if submenu_parent_handle == mobile_card_title_handle
                        assign is_matching_submenu_item = true
                      endif
                    endif

                    assign submenu_item_style = submenu_block.settings.item_style | default: 'card'
                  -%}

                  {%- if is_matching_submenu_item and submenu_item_style != 'button' -%}
                    {%- liquid
                      assign child_title = submenu_block.settings.title
                      assign child_link = submenu_block.settings.link
                      assign child_image = submenu_block.settings.image
                      assign child_image_asset = submenu_block.settings.image_asset | strip
                      assign child_badge = submenu_block.settings.badge
                      assign child_badge_normalized = child_badge | upcase
                      assign child_badge_style = 'new'
                      if child_badge_normalized contains 'HOT'
                        assign child_badge_style = 'hot'
                      elsif child_badge_normalized contains 'SALE' or child_badge_normalized contains 'FEATURED'
                        assign child_badge_style = 'sale'
                      endif
                    -%}
                    <li {{ submenu_block.shopify_attributes }}>
                      <a class="xstrape-header__mobile-card" {% if child_link != blank %}href="{{ child_link }}"{% endif %}>
                        <span class="xstrape-header__mobile-thumb {% if child_image == blank and child_image_asset == blank %}xstrape-header__mobile-thumb--placeholder{% endif %}">
                          {%- if child_image != blank -%}
                            {{ child_image | image_url: width: 320 | image_tag: loading: 'lazy', sizes: '74px' }}
                          {%- elsif child_image_asset != blank -%}
                            <img src="{{ child_image_asset | asset_url }}" alt="" loading="lazy" width="74" height="74">
                          {%- endif -%}
                        </span>
                        <span class="xstrape-header__mobile-body">
                          <span class="xstrape-header__mobile-title">
                            {{ child_title | escape }}
                            {%- if child_badge != blank -%}
                              <span class="xstrape-header__badge xstrape-header__badge--{{ child_badge_style }}">{{ child_badge | escape }}</span>
                            {%- endif -%}
                          </span>
                        </span>
                        <span class="xstrape-header__mobile-arrow" aria-hidden="true">&rsaquo;</span>
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}

                {%- for submenu_block in section.blocks -%}
                  {%- liquid
                    assign is_matching_submenu_item = false
                    assign submenu_parent_handle = submenu_block.settings.parent_title | handleize
                    if submenu_block.type == 'mobile_submenu_item' and submenu_block.settings.title != blank
                      if submenu_parent_handle == mobile_card_title_handle
                        assign is_matching_submenu_item = true
                      endif
                    endif

                    assign submenu_item_style = submenu_block.settings.item_style | default: 'card'
                  -%}

                  {%- if is_matching_submenu_item and submenu_item_style == 'button' -%}
                    <li {{ submenu_block.shopify_attributes }}>
                      <a class="xstrape-header__mobile-all-link" {% if submenu_block.settings.link != blank %}href="{{ submenu_block.settings.link }}"{% endif %}>{{ submenu_block.settings.title | escape }}</a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    const bar = section.querySelector('[data-xstrape-header-bar]');
    const panel = section.querySelector('#xstrape-mobile-panel-{{ section.id }}');
    const mobileSurface = panel?.querySelector('.xstrape-header__mobile-surface');
    const mobileMain = panel?.querySelector('[data-xstrape-mobile-main]');
    const mobileSubmenus = panel?.querySelectorAll('[data-xstrape-mobile-submenu]');
    const toggles = section.querySelectorAll('[data-xstrape-mobile-menu-toggle]');
    const desktopQuery = window.matchMedia('(min-width: 1150px)');
    let closeTimer;
    let heightTimer;
    const desktopCloseTimers = new WeakMap();

    const updateMetrics = () => {
      if (!bar) return;
      const rect = bar.getBoundingClientRect();
      const sectionStyle = window.getComputedStyle(section);
      const bottomGap = Number.parseFloat(sectionStyle.getPropertyValue('--xstrape-header-mobile-top-gap')) || 0;
      const viewportHeight = window.visualViewport?.height || window.innerHeight || document.documentElement.clientHeight;
      const panelMaxHeight = Math.max(rect.height, Math.round(viewportHeight - rect.top - bottomGap));

      section.style.setProperty('--xstrape-header-bar-real-height', `${Math.round(rect.height)}px`);
      section.style.setProperty('--xstrape-mobile-panel-top', `${Math.round(rect.top)}px`);
      section.style.setProperty('--xstrape-mobile-panel-closed-height', `${Math.round(rect.height)}px`);
      section.style.setProperty('--xstrape-mobile-panel-max-height', `${panelMaxHeight}px`);
      document.documentElement.style.setProperty('--header-height', `${Math.round(section.clientHeight)}px`);
    };

    const getActiveMobileLevel = () => {
      if (mobileMain && !mobileMain.hidden) return mobileMain;
      return Array.from(mobileSubmenus || []).find((submenu) => !submenu.hidden) || mobileMain;
    };

    const updateMobilePanelHeight = () => {
      if (!mobileSurface || !panel?.classList.contains('is-open')) return;

      updateMetrics();

      const activeLevel = getActiveMobileLevel();
      const surfaceStyle = window.getComputedStyle(mobileSurface);
      const paddingTop = Number.parseFloat(surfaceStyle.paddingTop) || 0;
      const paddingBottom = Number.parseFloat(surfaceStyle.paddingBottom) || 0;
      const maxHeight = Number.parseFloat(window.getComputedStyle(section).getPropertyValue('--xstrape-mobile-panel-max-height')) || window.innerHeight;
      const contentHeight = Math.ceil((activeLevel?.scrollHeight || 0) + paddingTop + paddingBottom);
      const targetHeight = Math.min(contentHeight, maxHeight);

      section.style.setProperty('--xstrape-mobile-panel-content-height', `${contentHeight}px`);
      section.style.setProperty('--xstrape-mobile-panel-target-height', `${targetHeight}px`);
      mobileSurface.style.height = `${targetHeight}px`;
      mobileSurface.style.maxHeight = `${maxHeight}px`;
    };

    const scheduleMobilePanelHeightUpdate = () => {
      window.clearTimeout(heightTimer);
      window.requestAnimationFrame(updateMobilePanelHeight);
      heightTimer = window.setTimeout(updateMobilePanelHeight, 90);
    };

    const clearDesktopCloseTimer = (item) => {
      const timer = desktopCloseTimers.get(item);
      if (timer) window.clearTimeout(timer);
      desktopCloseTimers.delete(item);
    };

    const scheduleDesktopClose = (item) => {
      clearDesktopCloseTimer(item);
      desktopCloseTimers.set(item, window.setTimeout(() => {
        item.removeAttribute('open');
        item.querySelector('[data-xstrape-mega-trigger]')?.setAttribute('aria-expanded', 'false');
        desktopCloseTimers.delete(item);
      }, 360));
    };

    const closeDesktopItems = (activeItem) => {
      section.querySelectorAll('[data-xstrape-mega-item]').forEach((item) => {
        clearDesktopCloseTimer(item);
        if (item !== activeItem) {
          item.removeAttribute('open');
          item.querySelector('[data-xstrape-mega-trigger]')?.setAttribute('aria-expanded', 'false');
        }
      });
    };

    const positionSimpleDesktopPanel = (item) => {
      const panel = item.querySelector('.xstrape-header__mega-panel--simple');
      const trigger = item.querySelector('[data-xstrape-mega-trigger]');
      const bar = section.querySelector('[data-xstrape-header-bar]');
      if (!panel || !trigger || !bar) return;

      const barRect = bar.getBoundingClientRect();
      const triggerRect = trigger.getBoundingClientRect();
      const panelWidth = Math.min(panel.getBoundingClientRect().width || 360, window.innerWidth - 56);
      const minCenter = panelWidth / 2 + 18;
      const maxCenter = window.innerWidth - panelWidth / 2 - 18;
      const desiredCenter = triggerRect.left + triggerRect.width / 2;
      const center = Math.min(Math.max(desiredCenter, minCenter), maxCenter);

      panel.style.setProperty('--xstrape-header-simple-left', `${center - barRect.left}px`);
    };

    section.querySelectorAll('[data-xstrape-mega-item]').forEach((item) => {
      const desktopPanel = item.querySelector('.xstrape-header__mega-panel');
      const desktopTrigger = item.querySelector('[data-xstrape-mega-trigger]');

      const openDesktopItem = () => {
        clearDesktopCloseTimer(item);
        closeDesktopItems(item);
        item.setAttribute('open', '');
        desktopTrigger?.setAttribute('aria-expanded', 'true');
        positionSimpleDesktopPanel(item);
      };

      const closeDesktopItem = () => {
        item.removeAttribute('open');
        desktopTrigger?.setAttribute('aria-expanded', 'false');
      };

      item.addEventListener('mouseenter', () => {
        if (!desktopQuery.matches) return;
        openDesktopItem();
      });

      item.addEventListener('pointerenter', () => {
        if (!desktopQuery.matches) return;
        openDesktopItem();
      });

      item.addEventListener('mouseover', (event) => {
        if (!desktopQuery.matches || !item.contains(event.target)) return;
        openDesktopItem();
      });

      item.addEventListener('mouseleave', () => {
        if (!desktopQuery.matches) return;
        scheduleDesktopClose(item);
      });

      desktopPanel?.addEventListener('mouseenter', () => {
        if (!desktopQuery.matches) return;
        clearDesktopCloseTimer(item);
        item.setAttribute('open', '');
        desktopTrigger?.setAttribute('aria-expanded', 'true');
      });

      desktopPanel?.addEventListener('pointerenter', () => {
        if (!desktopQuery.matches) return;
        clearDesktopCloseTimer(item);
        item.setAttribute('open', '');
        desktopTrigger?.setAttribute('aria-expanded', 'true');
      });

      desktopTrigger?.addEventListener('click', (event) => {
        if (!desktopQuery.matches) return;
        if (desktopTrigger.tagName === 'A' && desktopTrigger.getAttribute('href')) {
          closeDesktopItems();
          return;
        }

        event.preventDefault();

        if (item.hasAttribute('open')) {
          closeDesktopItem();
        } else {
          openDesktopItem();
        }
      });
    });

    const resetMobileSubmenus = () => {
      if (mobileMain) mobileMain.hidden = false;
      mobileSubmenus?.forEach((submenu) => {
        submenu.hidden = true;
      });
      mobileSurface?.scrollTo({ top: 0, behavior: 'auto' });
      scheduleMobilePanelHeightUpdate();
    };

    const openMobileSubmenu = (id) => {
      const submenu = Array.from(mobileSubmenus || []).find((item) => item.getAttribute('data-xstrape-mobile-submenu') === id);
      if (!submenu || !mobileMain) return;

      mobileMain.hidden = true;
      mobileSubmenus?.forEach((item) => {
        item.hidden = item !== submenu;
      });
      mobileSurface?.scrollTo({ top: 0, behavior: 'auto' });
      scheduleMobilePanelHeightUpdate();
    };

    const setOpen = (open) => {
      if (!panel || toggles.length === 0) return;
      window.clearTimeout(closeTimer);

      toggles.forEach((toggle) => {
        toggle.setAttribute('aria-expanded', String(open));
      });

      document.documentElement.classList.toggle('xstrape-mobile-menu-open', open);

      if (open) {
        updateMetrics();
        resetMobileSubmenus();
        panel.hidden = false;
        panel.offsetHeight;
        panel.classList.add('is-open');
        scheduleMobilePanelHeightUpdate();
        panel.querySelector('.xstrape-header__mobile-surface')?.focus({ preventScroll: true });
      } else {
        panel.classList.remove('is-open');
        if (mobileSurface) {
          mobileSurface.style.removeProperty('height');
          mobileSurface.style.removeProperty('max-height');
        }
        resetMobileSubmenus();
        closeTimer = window.setTimeout(() => {
          panel.hidden = true;
        }, 430);
      }
    };

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', (event) => {
        if (desktopQuery.matches) return;
        event.preventDefault();
        event.stopPropagation();
        setOpen(!panel?.classList.contains('is-open'));
      });
    });

    panel?.addEventListener('click', (event) => {
      const submenuTrigger = event.target.closest('[data-xstrape-mobile-submenu-open]');
      if (submenuTrigger) {
        event.preventDefault();
        event.stopPropagation();
        openMobileSubmenu(submenuTrigger.getAttribute('data-xstrape-mobile-submenu-open'));
        return;
      }

      if (event.target.closest('[data-xstrape-mobile-submenu-back]')) {
        event.preventDefault();
        event.stopPropagation();
        resetMobileSubmenus();
        return;
      }

      if (event.target.closest('[data-xstrape-mobile-menu-close]') || event.target.closest('a')) {
        setOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeDesktopItems();
        if (panel?.classList.contains('is-open')) setOpen(false);
      }
    });

    const onDesktopChange = (event) => {
      if (event.matches) setOpen(false);
    };

    updateMetrics();
    window.addEventListener('resize', updateMetrics, { passive: true });
    window.visualViewport?.addEventListener('resize', updateMetrics, { passive: true });
    window.addEventListener('resize', scheduleMobilePanelHeightUpdate, { passive: true });
    window.visualViewport?.addEventListener('resize', scheduleMobilePanelHeightUpdate, { passive: true });
    panel?.querySelectorAll('img').forEach((image) => {
      if (!image.complete) image.addEventListener('load', scheduleMobilePanelHeightUpdate, { once: true });
    });

    if (desktopQuery.addEventListener) {
      desktopQuery.addEventListener('change', onDesktopChange);
    } else {
      desktopQuery.addListener(onDesktopChange);
    }
  })();
</script>

