    }
  }

  /* The announcement line is long and was forced onto one line, which pushed the
     whole page sideways on narrow screens. Let it wrap inside the same bar height
     instead, and clip as a safety net. */
  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .xstrape-header__announcement {
      font-size: 12px;
      line-height: 1.25;
      white-space: normal;
