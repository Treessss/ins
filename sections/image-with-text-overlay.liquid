    {
      "name": "按钮",
      "type": "button",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "样式",
          "options": [
            {
              "value": "outline",
              "label": "描边"
            },
            {
              "value": "fill",
              "label": "填充"
            }
          ],
          "default": "fill"
        },
        {
          "type": "select",
          "id": "size",
          "label": "尺寸",
          "options": [
            {
              "value": "sm",
              "label": "小"
            },
            {
              "value": "base",
              "label": "中"
            },
            {
              "value": "lg",
              "label": "大"
            },
            {
              "value": "xl",
              "label": "特大"
            }
          ],
          "default": "lg"
        },
        {
          "type": "text",
          "id": "text",
          "label": "文本",
          "default": "Button text"
        },
        {
          "type": "url",
          "id": "url",
          "label": "链接"
        },
        {
          "type": "color",
          "id": "background",
          "label": "背景"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "文本"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "图片叠加文字",
      "category": "Banners",
      "blocks": [
        {
          "type": "subheading",
          "settings": {
            "text": "Subheading"
          }
        },
        {
          "type": "heading",
          "settings": {
            "text": "Image with text overlay",
            "heading_tag": "h1"
          }
        },
        {
          "type": "richtext"
        }
      ]
    }
  ]
}
