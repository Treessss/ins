	  <div class="xpr-lightbox" data-xpr-lightbox hidden role="dialog" aria-modal="true" aria-label="Customer review photo preview">
	    <div class="xpr-lightbox__panel">
	      <span class="xpr-lightbox__counter" data-xpr-lightbox-counter></span>
	      <button class="xpr-lightbox__close" type="button" data-xpr-lightbox-close aria-label="Close">&times;</button>
	      <button class="xpr-lightbox__arrow xpr-lightbox__arrow--prev" type="button" data-xpr-lightbox-prev aria-label="Previous photo">&lsaquo;</button>
	      <figure class="xpr-lightbox__figure">
	        <img class="xpr-lightbox__image" data-xpr-lightbox-image alt="" width="1200" height="1200">
	      </figure>
	      <button class="xpr-lightbox__arrow xpr-lightbox__arrow--next" type="button" data-xpr-lightbox-next aria-label="Next photo">&rsaquo;</button>
	      <div class="xpr-lightbox__thumbs" data-xpr-lightbox-thumbs aria-label="Customer review photo thumbnails"></div>
	    </div>
	  </div>
	</div>

	<script>
	  (() => {
	    const root = document.getElementById({{ 'xstrape-product-reviews-' | append: section.id | json }});
	    if (!root || root.dataset.xprInitialized === 'true') return;

	    root.dataset.xprInitialized = 'true';

	    const scrollToReviews = (event) => {
	      const trigger = event.target.closest('a[href^="#pm-reviews-anchor-"], button[data-anchor^="#pm-reviews-anchor-"], [data-scroll-to-reviews]');
	      if (!trigger) return;

	      event.preventDefault();
	      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
	    };

	    document.addEventListener('click', scrollToReviews);

	    const loadMore = root.querySelector('[data-xpr-load-more]');
	    if (loadMore) {
	      loadMore.addEventListener('click', () => {
	        root.querySelectorAll('[data-xpr-card][hidden]').forEach((card) => card.removeAttribute('hidden'));
	        loadMore.classList.remove('is-visible');
	      });
	    }

	    const lightbox = root.querySelector('[data-xpr-lightbox]');
	    const lightboxImage = root.querySelector('[data-xpr-lightbox-image]');
	    const lightboxCounter = root.querySelector('[data-xpr-lightbox-counter]');
	    const lightboxThumbs = root.querySelector('[data-xpr-lightbox-thumbs]');
	    const closeButton = root.querySelector('[data-xpr-lightbox-close]');
	    const prevButton = root.querySelector('[data-xpr-lightbox-prev]');
	    const nextButton = root.querySelector('[data-xpr-lightbox-next]');
	    const galleryItems = [];
	    const gallerySources = new Set();
	    let activeGalleryIndex = 0;
	    let previousDocumentOverflow = '';
	    let previousActiveElement = null;

	    root.querySelectorAll('[data-xpr-gallery-image]').forEach((item) => {
	      const src = item.dataset.xprGallerySrc;
	      if (!src || gallerySources.has(src)) return;

	      gallerySources.add(src);
	      galleryItems.push({
	        src,
	        thumb: item.dataset.xprGalleryThumb || src,
	        alt: item.dataset.xprGalleryAlt || 'Customer review photo'
	      });
	    });

	    const normalizeGalleryIndex = (index) => {
	      if (!galleryItems.length) return 0;
	      return ((index % galleryItems.length) + galleryItems.length) % galleryItems.length;
	    };

	    const findGalleryIndex = (src) => galleryItems.findIndex((item) => item.src === src);

	    const ensureGalleryItem = (trigger) => {
	      const src = trigger.dataset.xprGallerySrc;
	      if (!src) return -1;

	      const existingIndex = findGalleryIndex(src);
	      if (existingIndex >= 0) return existingIndex;

	      const image = trigger.querySelector('img');
	      gallerySources.add(src);
	      galleryItems.push({
	        src,
	        thumb: image ? image.currentSrc || image.src || src : src,
	        alt: image ? image.alt || 'Customer review photo' : 'Customer review photo'
	      });

	      return galleryItems.length - 1;
	    };

	    const renderGalleryThumbs = () => {
	      if (!lightboxThumbs) return;

	      lightboxThumbs.innerHTML = '';
	      galleryItems.forEach((item, index) => {
	        const thumbButton = document.createElement('button');
	        const thumbImage = document.createElement('img');

	        thumbButton.type = 'button';
	        thumbButton.className = 'xpr-lightbox__thumb';
	        thumbButton.setAttribute('aria-label', `View photo ${index + 1}`);
	        if (index === activeGalleryIndex) thumbButton.setAttribute('aria-current', 'true');

	        thumbImage.src = item.thumb;
	        thumbImage.alt = '';
	        thumbButton.appendChild(thumbImage);
	        thumbButton.addEventListener('click', () => {
	          activeGalleryIndex = index;
	          updateGallery();
	        });

	        lightboxThumbs.appendChild(thumbButton);
	      });
	    };

	    function updateGallery() {
	      if (!lightboxImage || !galleryItems.length) return;

	      const item = galleryItems[activeGalleryIndex];
	      lightboxImage.src = item.src;
	      lightboxImage.alt = item.alt;

	      if (lightboxCounter) {
	        lightboxCounter.textContent = `${activeGalleryIndex + 1} / ${galleryItems.length}`;
	      }

	      const hasMultipleItems = galleryItems.length > 1;
	      [prevButton, nextButton].forEach((button) => {
	        if (!button) return;

	        button.hidden = !hasMultipleItems;
	        button.disabled = !hasMultipleItems;
	      });

	      renderGalleryThumbs();
	    }

	    const openGallery = (index) => {
	      if (!lightbox || !lightboxImage || !galleryItems.length) return;

	      const wasHidden = lightbox.hidden;
	      activeGalleryIndex = normalizeGalleryIndex(index);
	      lightbox.hidden = false;

	      if (wasHidden) {
	        previousDocumentOverflow = document.documentElement.style.overflow;
	        previousActiveElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
	        document.documentElement.style.overflow = 'hidden';
	      }

	      updateGallery();

	      if (closeButton) {
	        closeButton.focus({ preventScroll: true });
	      }
	    };

	    const closeGallery = () => {
	      if (!lightbox || lightbox.hidden) return;

	      lightbox.hidden = true;
	      document.documentElement.style.overflow = previousDocumentOverflow;

	      if (lightboxImage) {
	        lightboxImage.removeAttribute('src');
	        lightboxImage.alt = '';
	      }

	      if (previousActiveElement) {
	        previousActiveElement.focus({ preventScroll: true });
	      }
	    };

	    const moveGallery = (offset) => {
	      activeGalleryIndex = normalizeGalleryIndex(activeGalleryIndex + offset);
	      updateGallery();
	    };

	    root.addEventListener('click', (event) => {
	      const moreTrigger = event.target.closest('[data-xpr-gallery-more]');
	      if (moreTrigger && root.contains(moreTrigger)) {
	        event.preventDefault();
	        openGallery(0);
	        return;
	      }

	      const imageTrigger = event.target.closest('[data-xpr-gallery-trigger]');
	      if (!imageTrigger || !root.contains(imageTrigger)) return;

	      event.preventDefault();
	      const galleryIndex = ensureGalleryItem(imageTrigger);
	      openGallery(galleryIndex >= 0 ? galleryIndex : 0);
	    });

	    if (lightbox) {
	      lightbox.addEventListener('click', (event) => {
	        if (event.target === lightbox) closeGallery();
	      });
	    }

	    if (closeButton) closeButton.addEventListener('click', closeGallery);
	    if (prevButton) prevButton.addEventListener('click', () => moveGallery(-1));
	    if (nextButton) nextButton.addEventListener('click', () => moveGallery(1));

	    document.addEventListener('keydown', (event) => {
	      if (!lightbox || lightbox.hidden) return;

	      if (event.key === 'Escape') {
	        closeGallery();
	      } else if (event.key === 'ArrowLeft') {
	        event.preventDefault();
	        moveGallery(-1);
	      } else if (event.key === 'ArrowRight') {
	        event.preventDefault();
	        moveGallery(1);
	      }
	    });
	  })();
	</script>

