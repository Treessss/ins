                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if media_count > 0 -%}
                <div class="xpr-review-media" style="--xpr-media-count: {{ media_columns }};">
	                  {%- if series_review_image != blank -%}
	                    {%- assign series_review_full_url = series_review_image | image_url: width: 1800 -%}
	                    <button
	                      type="button"
	                      class="xpr-review-media__item"
	                      data-xpr-gallery-trigger
	                      data-xpr-gallery-src="{{ series_review_full_url }}"
	                      aria-label="Preview customer review photo"
	                    >
	                      {{ series_review_image | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
	                    </button>
	                  {%- elsif fallback_review_image != blank -%}
	                    {%- assign fallback_review_full_url = fallback_review_image | image_url: width: 1800 -%}
	                    <button
	                      type="button"
	                      class="xpr-review-media__item"
	                      data-xpr-gallery-trigger
	                      data-xpr-gallery-src="{{ fallback_review_full_url }}"
	                      aria-label="Preview customer review photo"
	                    >
	                      {{ fallback_review_image | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
	                    </button>
	                  {%- else -%}
	                    {%- if fallback_review_block.settings.image_1 != blank -%}
	                      {%- assign fallback_review_full_url = fallback_review_block.settings.image_1 | image_url: width: 1800 -%}
	                      <button
	                        type="button"
	                        class="xpr-review-media__item"
	                        data-xpr-gallery-trigger
	                        data-xpr-gallery-src="{{ fallback_review_full_url }}"
	                        aria-label="Preview customer review photo"
	                      >
	                        {{ fallback_review_block.settings.image_1 | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
	                      </button>
	                    {%- endif -%}
	                    {%- if fallback_review_block.settings.image_2 != blank -%}
	                      {%- assign fallback_review_full_url = fallback_review_block.settings.image_2 | image_url: width: 1800 -%}
	                      <button
	                        type="button"
	                        class="xpr-review-media__item"
	                        data-xpr-gallery-trigger
	                        data-xpr-gallery-src="{{ fallback_review_full_url }}"
	                        aria-label="Preview customer review photo"
	                      >
	                        {{ fallback_review_block.settings.image_2 | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
	                      </button>
	                    {%- endif -%}
	                    {%- if fallback_review_block.settings.image_3 != blank -%}
	                      {%- assign fallback_review_full_url = fallback_review_block.settings.image_3 | image_url: width: 1800 -%}
	                      <button
	                        type="button"
	                        class="xpr-review-media__item"
	                        data-xpr-gallery-trigger
	                        data-xpr-gallery-src="{{ fallback_review_full_url }}"
	                        aria-label="Preview customer review photo"
	                      >
	                        {{ fallback_review_block.settings.image_3 | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
	                      </button>
	                    {%- endif -%}
	                    {%- if fallback_review_block.settings.image_4 != blank -%}
	                      {%- assign fallback_review_full_url = fallback_review_block.settings.image_4 | image_url: width: 1800 -%}
	                      <button
	                        type="button"
	                        class="xpr-review-media__item"
	                        data-xpr-gallery-trigger
	                        data-xpr-gallery-src="{{ fallback_review_full_url }}"
	                        aria-label="Preview customer review photo"
	                      >
	                        {{ fallback_review_block.settings.image_4 | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
	                      </button>
	                    {%- endif -%}
                    {%- if fallback_review_block.settings.video_url != blank -%}
                      <div class="xpr-review-media__item">
                        {{ fallback_review_block.settings.video_url | external_video_tag }}
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="xpr-review-meta">
                {%- if fallback_review_block.settings.author != blank -%}
                  <span>{{ fallback_review_block.settings.author | escape }}</span>
                {%- endif -%}
                {%- if fallback_review_block.settings.verified -%}
                  <span>{{ section.settings.verified_label | escape }}</span>
                {%- endif -%}
                {%- if fallback_review_block.settings.tag != blank -%}
                  <span class="xpr-tag">{{ fallback_review_block.settings.tag | escape }}</span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if review_count > section.settings.initial_visible_reviews -%}
        <button class="xpr-load-more is-visible" type="button" data-xpr-load-more>
          {{ section.settings.load_more_text | escape }}
