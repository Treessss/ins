{%- liquid
  assign total_reviews = section.settings.review_count | plus: 0
  if product != blank
    assign product_nomad_review_seed = product.id | modulo: 1001
    assign total_reviews = 4000 | plus: product_nomad_review_seed
  endif
  assign average_rating = section.settings.average_rating | default: '4.8'
  assign average_rating_fill = average_rating | plus: 0 | times: 100
  assign recommendation_percent = section.settings.recommendation_percent | plus: 0
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign media_blocks = section.blocks | where: 'type', 'media'
  assign fallback_review_media_blocks = section.blocks | where: 'type', 'fallback_review_image'
  assign fallback_review_media_count = 0
  assign fallback_review_media_offset = 0
  for fallback_review_media_block in fallback_review_media_blocks
    if fallback_review_media_block.settings.image != blank
      assign fallback_review_media_count = fallback_review_media_count | plus: 1
    endif
  endfor
  if product != blank and fallback_review_media_count > 0
    assign fallback_review_media_offset = product.id | modulo: fallback_review_media_count
  endif
  assign review_text_pool = section.settings.review_text_pool | strip
  assign review_text_lines = blank
  assign review_text_count = 0
  if product != blank
    assign product_reviews_metafield = product.metafields.custom.reviews
    if product_reviews_metafield != blank and product_reviews_metafield.value != blank
      if product_reviews_metafield.type contains 'list.'
        assign review_text_lines = product_reviews_metafield.value
      else
        assign product_reviews_text = product_reviews_metafield.value | strip
        if product_reviews_text != blank
          assign review_text_lines = product_reviews_text | newline_to_br | split: '<br />'
        endif
      endif
    endif
  endif
  if review_text_lines != blank
    for review_text_line in review_text_lines
      assign review_text_line_content = review_text_line | strip
      if review_text_line_content != blank
        assign review_text_count = review_text_count | plus: 1
      endif
    endfor
  endif
  if review_text_count == 0 and review_text_pool != blank
    assign review_text_lines = review_text_pool | newline_to_br | split: '<br />'
    for review_text_line in review_text_lines
      assign review_text_line_content = review_text_line | strip
      if review_text_line_content != blank
        assign review_text_count = review_text_count | plus: 1
      endif
    endfor
  endif
  assign review_source_count = review_blocks.size
  if review_text_count > 0
    assign review_source_count = review_text_count
  endif
  assign review_count = review_source_count
  if review_count > 25
    assign review_count = 25
  endif
  assign review_random_seed_base = 0
  if product != blank
    assign review_random_seed_base = product.id | modulo: 100000
  endif
  assign review_offset = 0
  if product != blank and review_source_count > 0
    assign review_offset = product.id | modulo: review_source_count
  endif

  assign enable_random_review_dates = true
  if section.settings.enable_random_review_dates == false
    assign enable_random_review_dates = false
  endif
  assign review_date_min_days_ago = section.settings.review_date_min_days_ago | default: 7 | plus: 0
  assign review_date_max_days_ago = section.settings.review_date_max_days_ago | default: 180 | plus: 0
  if review_date_min_days_ago < 0
    assign review_date_min_days_ago = 0
  endif
  if review_date_max_days_ago < 0
    assign review_date_max_days_ago = 0
  endif
  assign review_date_range_start = review_date_min_days_ago
  assign review_date_range_end = review_date_max_days_ago
  if review_date_range_start > review_date_range_end
    assign review_date_range_start = review_date_max_days_ago
    assign review_date_range_end = review_date_min_days_ago
  endif
  assign review_date_range_size = review_date_range_end | minus: review_date_range_start | plus: 1
  assign review_date_format = section.settings.review_date_format | default: '%b %d, %Y'

  assign enable_random_review_ratings = true
  if section.settings.enable_random_review_ratings == false
    assign enable_random_review_ratings = false
  endif
  assign review_rating_min = section.settings.review_rating_min | default: '4.5' | plus: 0
  assign review_rating_max = section.settings.review_rating_max | default: '5' | plus: 0
  if review_rating_min < 1
    assign review_rating_min = 1
  elsif review_rating_min > 5
    assign review_rating_min = 5
  endif
  if review_rating_max < 1
    assign review_rating_max = 1
  elsif review_rating_max > 5
    assign review_rating_max = 5
  endif
  if review_rating_min > review_rating_max
    assign review_rating_swap = review_rating_min
    assign review_rating_min = review_rating_max
    assign review_rating_max = review_rating_swap
  endif
  assign review_rating_min_halves = review_rating_min | times: 2 | round
  assign review_rating_max_halves = review_rating_max | times: 2 | round
  assign review_rating_range_size = review_rating_max_halves | minus: review_rating_min_halves | plus: 1

  assign series_review_media_source = blank
  assign series_review_media_count = 0
  assign series_review_media_is_single = false
  assign series_review_media_is_list = false
  assign enable_series_review_photos = true
  if section.settings.enable_series_review_photos == false
    assign enable_series_review_photos = false
  endif
  assign series_review_photo_namespace = section.settings.series_review_photo_namespace | default: 'custom' | strip
  assign series_review_photo_key = section.settings.series_review_photo_key | default: 'series_reviews_photo' | strip
  assign review_source_collection_namespace = section.settings.review_source_collection_namespace | default: 'custom' | strip
  assign review_source_collection_key = section.settings.review_source_collection_key | default: 'review_source_collection' | strip

  if product != blank
    assign product_review_media_metafield = product.metafields.custom.reviews_photo
    if product_review_media_metafield != blank and product_review_media_metafield.value != blank
      assign series_review_media_source = product_review_media_metafield.value
      if product_review_media_metafield.type contains 'list.'
        assign series_review_media_is_list = true
      endif
    endif
  endif

  if series_review_media_source == blank and enable_series_review_photos and product != blank and series_review_photo_namespace != blank and series_review_photo_key != blank
    assign preferred_review_collection = product.metafields[review_source_collection_namespace][review_source_collection_key].value

    if preferred_review_collection != blank
      assign preferred_review_media_metafield = preferred_review_collection.metafields[series_review_photo_namespace][series_review_photo_key]
      if preferred_review_media_metafield != blank and preferred_review_media_metafield.value != blank
        assign series_review_media_source = preferred_review_media_metafield.value
        if preferred_review_media_metafield.type contains 'list.'
          assign series_review_media_is_list = true
        endif
      endif
    endif

    if series_review_media_source == blank
      for candidate_collection in product.collections
        assign candidate_review_media_metafield = candidate_collection.metafields[series_review_photo_namespace][series_review_photo_key]
        if candidate_review_media_metafield != blank and candidate_review_media_metafield.value != blank
          assign series_review_media_source = candidate_review_media_metafield.value
          if candidate_review_media_metafield.type contains 'list.'
            assign series_review_media_is_list = true
          endif
          break
        endif
      endfor
    endif
  endif

  if series_review_media_source != blank
    assign series_review_single_image = series_review_media_source
    if series_review_single_image.preview_image != blank
      assign series_review_single_image = series_review_single_image.preview_image
    endif

    if series_review_single_image.width != blank
      assign series_review_media_count = 1
      assign series_review_media_is_single = true
    elsif series_review_media_is_list
      for series_review_media in series_review_media_source
        assign series_review_image_candidate = series_review_media
        if series_review_image_candidate.preview_image != blank
          assign series_review_image_candidate = series_review_image_candidate.preview_image
        endif

        if series_review_image_candidate.width != blank
          assign series_review_media_count = series_review_media_count | plus: 1
        endif
      endfor
    endif
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --xpr-bg: {{ section.settings.background | default: '#F2F9ED' }};
    --xpr-surface: {{ section.settings.card_background | default: '#ffffff' }};
    --xpr-text: {{ section.settings.text_color | default: '#17132F' }};
    --xpr-muted: {{ section.settings.muted_text_color | default: '#17132F' }};
    --xpr-star: {{ section.settings.star_color | default: '#17132F' }};
    --xpr-star-empty: #c2c1c0;
    --xpr-rule: #F2F9ED;
    --xpr-body: var(--text-font-family), sans-serif;
    --xpr-gotham-book: "Xstrapetm Text", sans-serif;
    --xpr-gotham-bold: "Xstrapetm Display", sans-serif;
  }

  #shopify-section-{{ section.id }} .xstrape-product-reviews {
    background: var(--xpr-bg);
    color: var(--xpr-text);
    padding-block: 44px 64px;
    padding-inline: 0;
    font-family: var(--xpr-body);
    font-size: 16px;
    line-height: 24px;
  }

  #shopify-section-{{ section.id }} .xstrape-product-reviews,
  #shopify-section-{{ section.id }} .xstrape-product-reviews * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .xpr-container {
    width: calc(100vw - 40px);
    max-width: 100%;
    margin-inline: auto;
    padding: 25px 35px;
    background: var(--xpr-surface);
    border: 0;
    border-radius: 25px;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .xpr-head {
    display: flex;
    gap: 30px 60px;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 30px;
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .xpr-head__copy,
  #shopify-section-{{ section.id }} .xpr-head__media {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .xpr-head__copy {
    flex: 1 1 auto;
  }

  #shopify-section-{{ section.id }} .xpr-head__media {
    flex: 0 1 auto;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .xpr-title-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin: 0 0 10px;
  }

  #shopify-section-{{ section.id }} .xpr-heading {
    margin: 0 10px 0 0;
    color: var(--xpr-text);
    font-family: var(--xpr-gotham-bold);
    font-size: 40px;
    line-height: 44.4px;
    letter-spacing: 0;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .xpr-heading-meta {
    display: inline-flex;
    align-items: center;
    gap: 0;
    color: var(--xpr-text);
    font-family: var(--xpr-gotham-book);
    font-size: 13px;
    line-height: normal;
    font-weight: 400;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .xpr-heading-meta__count {
    color: var(--xpr-text);
    text-decoration: underline;
    text-underline-offset: auto;
    margin: 2px 0 0 5px;
  }

  #shopify-section-{{ section.id }} .xpr-stars {
    display: inline-flex;
    align-items: center;
    gap: 1px;
    color: var(--xpr-star);
    line-height: 0;
    --xpr-star-size: 15px;
  }

  #shopify-section-{{ section.id }} .xpr-star-icon {
    width: var(--xpr-star-size);
    height: var(--xpr-star-size);
    flex: 0 0 var(--xpr-star-size);
    background: linear-gradient(90deg, var(--xpr-star) 0 var(--xpr-fill, 100%), var(--xpr-star-empty) var(--xpr-fill, 100%) 100%);
    -webkit-mask: url("data:image/svg+xml,%3Csvg viewBox='0 0 20 19' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M10 0l2.94 6.12 6.75.94-4.9 4.74 1.2 6.7L10 15.32 4.01 18.5l1.2-6.7-4.9-4.74 6.75-.94L10 0z'/%3E%3C/svg%3E") center / contain no-repeat;
    mask: url("data:image/svg+xml,%3Csvg viewBox='0 0 20 19' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M10 0l2.94 6.12 6.75.94-4.9 4.74 1.2 6.7L10 15.32 4.01 18.5l1.2-6.7-4.9-4.74 6.75-.94L10 0z'/%3E%3C/svg%3E") center / contain no-repeat;
  }

  #shopify-section-{{ section.id }} .xpr-recommendation {
    margin: 0;
    color: var(--xpr-muted);
    font-family: var(--xpr-body);
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .xpr-media-strip {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: flex-end;
    max-width: 100%;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .xpr-media-thumb,
  #shopify-section-{{ section.id }} .xpr-media-more {
    position: relative;
    width: 71px;
    height: 71px;
    flex: 0 0 71px;
    overflow: hidden;
    border-radius: 10px;
    background: transparent;
  }

  #shopify-section-{{ section.id }} button.xpr-media-thumb,
  #shopify-section-{{ section.id }} button.xpr-review-media__item {
    padding: 0;
    border: 0;
    appearance: none;
    cursor: zoom-in;
  }

  #shopify-section-{{ section.id }} .xpr-media-thumb img,
  #shopify-section-{{ section.id }} .xpr-media-thumb iframe {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border: 0;
  }

  #shopify-section-{{ section.id }} .xpr-media-more {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 2px solid rgba(23, 19, 47, 0.14);
    background: linear-gradient(181deg, #F2F9ED, #F2F9ED);
    color: var(--xpr-text);
    font-family: var(--xpr-gotham-book);
    font-size: 14px;
    line-height: normal;
    font-weight: 400;
    text-align: center;
    cursor: zoom-in;
  }

  #shopify-section-{{ section.id }} .xpr-media-more:hover,
  #shopify-section-{{ section.id }} .xpr-media-more:focus-visible,
  #shopify-section-{{ section.id }} button.xpr-media-thumb:hover,
  #shopify-section-{{ section.id }} button.xpr-review-media__item:hover,
  #shopify-section-{{ section.id }} button.xpr-media-thumb:focus-visible,
  #shopify-section-{{ section.id }} button.xpr-review-media__item:focus-visible {
    outline: 2px solid rgb(0 0 0 / 0.18);
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .xpr-summary {
    width: 600px;
    max-width: 100%;
    padding: 20px 0;
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .xpr-summary__heading {
    margin: 0 0 10px;
    color: var(--xpr-text);
    font-family: var(--xpr-gotham-bold);
    font-size: 20px;
    line-height: 22.2px;
    letter-spacing: 0;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .xpr-summary__body {
    max-width: 600px;
    color: var(--xpr-muted);
    font-family: var(--xpr-body);
    font-size: 16px;
    line-height: 24px;
  }

  #shopify-section-{{ section.id }} .xpr-summary__body p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .xpr-summary__caption {
    margin-top: 10px;
    color: var(--xpr-muted);
    font-family: var(--xpr-gotham-bold);
    font-size: 14px;
    line-height: 17.5px;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .xpr-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px 0;
  }

  #shopify-section-{{ section.id }} .xpr-toolbar__title {
    color: var(--xpr-text);
    font-family: var(--xpr-gotham-bold);
    font-size: 20px;
    line-height: 22.2px;
    letter-spacing: 0;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .xpr-toolbar__pill {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 14px;
    border: 1px solid var(--xpr-rule);
    border-radius: 999px;
    color: var(--xpr-text);
    background: var(--xpr-surface);
    font-family: var(--xpr-gotham-book);
    font-size: 13px;
    line-height: normal;
    font-weight: 400;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .xpr-list {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .xpr-review-row {
    display: flex;
    padding: 30px 0;
    border-top: 2px solid var(--xpr-rule);
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .xpr-review-row:last-child {
    padding-bottom: 0;
  }

  #shopify-section-{{ section.id }} .xpr-review-row[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .xpr-review-content {
    width: min(100%, 696px);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  #shopify-section-{{ section.id }} .xpr-review-topline {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin: 0 0 10px;
  }

  #shopify-section-{{ section.id }} .xpr-review-topline .xpr-stars {
    --xpr-star-size: 19px;
  }

  #shopify-section-{{ section.id }} .xpr-review-date {
    color: var(--xpr-muted);
    font-family: var(--xpr-gotham-book);
    font-size: 14px;
    line-height: 17.5px;
    font-weight: 400;
    padding-top: 3px;
  }

  #shopify-section-{{ section.id }} .xpr-review-title {
    margin: 0;
    color: var(--xpr-text);
    font-family: var(--xpr-gotham-bold);
    font-size: 20px;
    line-height: 22.2px;
    letter-spacing: 0;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .xpr-review-body {
    color: var(--xpr-text);
    font-family: var(--xpr-body);
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .xpr-review-body p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .xpr-review-media {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
    max-width: 100%;
    margin-top: 10px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .xpr-review-media__item {
    width: 71px;
    height: 71px;
    flex: 0 0 71px;
    overflow: hidden;
    border-radius: 10px;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .xpr-review-media__item img,
  #shopify-section-{{ section.id }} .xpr-review-media__item iframe {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border: 0;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: grid;
    place-items: center;
    padding: 24px;
    background: rgb(0 0 0 / 0.82);
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__panel {
    position: relative;
    width: min(1120px, 100%);
    max-height: calc(100vh - 48px);
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__figure {
    min-height: 0;
    margin: 0;
    display: grid;
    place-items: center;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__image {
    max-width: 100%;
    max-height: min(78vh, 820px);
    width: auto;
    height: auto;
    display: block;
    border-radius: 8px;
    background: #17132F;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__counter {
    position: absolute;
    left: 0;
    top: -2px;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
    color: #ffffff;
    font-family: var(--xpr-gotham-book);
    font-size: 13px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__close,
  #shopify-section-{{ section.id }} .xpr-lightbox__arrow {
    position: absolute;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    color: #17132F;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__close {
    top: -2px;
    right: 0;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__arrow {
    top: 50%;
    transform: translateY(-50%);
    font-size: 24px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__arrow--prev {
    left: 0;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__arrow--next {
    right: 0;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__close:hover,
  #shopify-section-{{ section.id }} .xpr-lightbox__arrow:hover,
  #shopify-section-{{ section.id }} .xpr-lightbox__thumb:hover,
  #shopify-section-{{ section.id }} .xpr-lightbox__close:focus-visible,
  #shopify-section-{{ section.id }} .xpr-lightbox__arrow:focus-visible,
  #shopify-section-{{ section.id }} .xpr-lightbox__thumb:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__thumbs {
    max-width: 100%;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 3px 0;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__thumbs::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__thumb {
    width: 58px;
    height: 58px;
    flex: 0 0 58px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    background: transparent;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__thumb[aria-current="true"] {
    border-color: #ffffff;
  }

  #shopify-section-{{ section.id }} .xpr-lightbox__thumb img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .xpr-review-meta {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 18px;
    color: var(--xpr-muted);
    font-size: 14px;
    line-height: 1.25;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .xpr-tag {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 10px;
