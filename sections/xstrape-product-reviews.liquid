                      assign row_star_start = i | minus: 1
                      assign row_star_fill = display_review_rating | minus: row_star_start | times: 100
                      if row_star_fill > 100
                        assign row_star_fill = 100
                      elsif row_star_fill < 0
                        assign row_star_fill = 0
                      endif
