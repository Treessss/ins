    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .xpr-empty {
    padding: 28px 0 0;
    color: var(--xpr-muted);
    font-size: 18px;
    line-height: 1.4;
    font-weight: 700;
    text-align: center;
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .xstrape-product-reviews {
      padding-block: 28px 48px;
    }

    #shopify-section-{{ section.id }} .xpr-container {
      width: min(100% - 20px, 720px);
      max-width: calc(100vw - 20px);
      padding: 22px 20px;
      border-radius: 25px;
    }

    #shopify-section-{{ section.id }} .xpr-head,
    #shopify-section-{{ section.id }} .xpr-toolbar {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
      padding-bottom: 28px;
    }

    #shopify-section-{{ section.id }} .xpr-heading {
      font-size: 34px;
      line-height: 37.7px;
    }

    #shopify-section-{{ section.id }} .xpr-heading-meta {
      font-size: 13px;
      white-space: normal;
    }

    #shopify-section-{{ section.id }} .xpr-stars {
      --xpr-star-size: 15px;
    }

    #shopify-section-{{ section.id }} .xpr-recommendation {
      font-size: 16px;
      line-height: 24px;
    }

    #shopify-section-{{ section.id }} .xpr-media-strip {
      width: 100%;
      max-width: 100%;
      justify-content: start;
      gap: 10px;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #shopify-section-{{ section.id }} .xpr-media-strip::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .xpr-media-thumb,
    #shopify-section-{{ section.id }} .xpr-media-more {
      width: 71px;
      height: 71px;
      flex-basis: 71px;
      border-radius: 10px;
    }

    #shopify-section-{{ section.id }} .xpr-media-more {
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .xpr-media-thumb--mobile-hidden {
      display: none;
    }

    #shopify-section-{{ section.id }} .xpr-review-row {
      min-width: 0;
      padding-block: 30px;
    }

    #shopify-section-{{ section.id }} .xpr-review-content {
      width: 100%;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .xpr-review-topline {
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .xpr-review-topline .xpr-stars {
      --xpr-star-size: 19px;
    }

    #shopify-section-{{ section.id }} .xpr-review-date {
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .xpr-review-title {
      font-size: 20px;
      line-height: 22.2px;
    }

    #shopify-section-{{ section.id }} .xpr-review-body {
      font-size: 16px;
      line-height: 24px;
    }

    #shopify-section-{{ section.id }} .xpr-review-media__item {
      width: 71px;
      height: 71px;
      flex-basis: 71px;
    }

    #shopify-section-{{ section.id }} .xpr-lightbox {
      padding: 14px;
    }

    #shopify-section-{{ section.id }} .xpr-lightbox__panel {
      max-height: calc(100vh - 28px);
    }

    #shopify-section-{{ section.id }} .xpr-lightbox__image {
      max-height: 72vh;
    }

    #shopify-section-{{ section.id }} .xpr-lightbox__arrow {
      width: 38px;
      height: 38px;
    }

    #shopify-section-{{ section.id }} .xpr-lightbox__thumb {
      width: 52px;
      height: 52px;
      flex-basis: 52px;
    }
  }
</style>

<div
  id="xstrape-product-reviews-{{ section.id }}"
  {% render 'section-properties', class: 'xstrape-product-reviews' %}
  data-xstrape-product-reviews
>
  <div class="xpr-container">
    <div class="xpr-head">
      <div class="xpr-head__copy">
        <div class="xpr-title-line">
          {%- if section.settings.heading != blank -%}
            <h2 class="xpr-heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          <div class="xpr-heading-meta">
            <span class="xpr-stars" aria-label="{{ average_rating }} out of 5 stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                {%- liquid
                  assign star_start = i | minus: 1 | times: 100
                  assign star_fill = average_rating_fill | minus: star_start
                  if star_fill > 100
                    assign star_fill = 100
                  elsif star_fill < 0
                    assign star_fill = 0
                  endif
                -%}
                <span class="xpr-star-icon" style="--xpr-fill: {{ star_fill }}%;"></span>
              {%- endfor -%}
            </span>
            <span class="xpr-heading-meta__count">{{ total_reviews }} {{ section.settings.review_count_label | escape }}</span>
          </div>
        </div>

        {%- if section.settings.recommendation_text != blank -%}
          <p class="xpr-recommendation">
            {{ recommendation_percent }}% {{ section.settings.recommendation_text | escape }}
          </p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_media_strip -%}
        <div class="xpr-head__media">
          <div class="xpr-media-strip" aria-label="{{ section.settings.media_heading | default: 'Customer review media' | escape }}">
            {%- assign media_rendered = 0 -%}

            {%- if series_review_media_count > 0 -%}
              {%- if series_review_media_is_single -%}
                {%- liquid
                  assign series_strip_image = series_review_media_source
                  if series_strip_image.preview_image != blank
                    assign series_strip_image = series_strip_image.preview_image
                  endif
                -%}
                {%- if series_strip_image.width != blank -%}
                  {%- assign media_rendered = media_rendered | plus: 1 -%}
                  {%- assign series_strip_full_url = series_strip_image | image_url: width: 1800 -%}
                  <button
                    type="button"
	                    class="xpr-media-thumb{% if media_rendered > 3 %} xpr-media-thumb--mobile-hidden{% endif %}"
                    data-xpr-gallery-trigger
                    data-xpr-gallery-src="{{ series_strip_full_url }}"
                    aria-label="Preview customer review photo"
                  >
                    {{ series_strip_image | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
                  </button>
                {%- endif -%}
              {%- else -%}
                {%- for series_strip_media in series_review_media_source -%}
                  {%- liquid
                    assign series_strip_image = series_strip_media
                    if series_strip_image.preview_image != blank
                      assign series_strip_image = series_strip_image.preview_image
                    endif
                  -%}
                  {%- if media_rendered < section.settings.media_limit and series_strip_image.width != blank -%}
                    {%- assign media_rendered = media_rendered | plus: 1 -%}
                    {%- assign series_strip_full_url = series_strip_image | image_url: width: 1800 -%}
                    <button
                      type="button"
	                      class="xpr-media-thumb{% if media_rendered > 3 %} xpr-media-thumb--mobile-hidden{% endif %}"
                      data-xpr-gallery-trigger
                      data-xpr-gallery-src="{{ series_strip_full_url }}"
                      aria-label="Preview customer review photo"
                    >
                      {{ series_strip_image | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
                    </button>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- elsif fallback_review_media_count > 0 -%}
              {%- for fallback_media_block in fallback_review_media_blocks -%}
                {%- if media_rendered < section.settings.media_limit and fallback_media_block.settings.image != blank -%}
                  {%- assign media_rendered = media_rendered | plus: 1 -%}
                  {%- assign fallback_strip_full_url = fallback_media_block.settings.image | image_url: width: 1800 -%}
                  <button
                    type="button"
	                    class="xpr-media-thumb{% if media_rendered > 3 %} xpr-media-thumb--mobile-hidden{% endif %}"
                    data-xpr-gallery-trigger
                    data-xpr-gallery-src="{{ fallback_strip_full_url }}"
                    aria-label="Preview customer review photo"
                    {{ fallback_media_block.shopify_attributes }}
                  >
                    {{ fallback_media_block.settings.image | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
                  </button>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for block in media_blocks -%}
                {%- if media_rendered < section.settings.media_limit and block.settings.image != blank -%}
                  {%- assign media_rendered = media_rendered | plus: 1 -%}
                  {%- assign media_block_full_url = block.settings.image | image_url: width: 1800 -%}
                  <button
                    type="button"
	                    class="xpr-media-thumb{% if media_rendered > 3 %} xpr-media-thumb--mobile-hidden{% endif %}"
                    data-xpr-gallery-trigger
                    data-xpr-gallery-src="{{ media_block_full_url }}"
                    aria-label="Preview customer review photo"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.image | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
                  </button>
                {%- elsif media_rendered < section.settings.media_limit and block.settings.video_url != blank -%}
                  {%- assign media_rendered = media_rendered | plus: 1 -%}
	                  <div class="xpr-media-thumb{% if media_rendered > 3 %} xpr-media-thumb--mobile-hidden{% endif %}" {{ block.shopify_attributes }}>
                    {{ block.settings.video_url | external_video_tag }}
                  </div>
                {%- endif -%}
              {%- endfor -%}

              {%- for block in review_blocks -%}
                {%- if media_rendered < section.settings.media_limit and block.settings.image_1 != blank -%}
                  {%- assign media_rendered = media_rendered | plus: 1 -%}
                  {%- assign review_strip_full_url = block.settings.image_1 | image_url: width: 1800 -%}
                  <button
                    type="button"
	                    class="xpr-media-thumb{% if media_rendered > 3 %} xpr-media-thumb--mobile-hidden{% endif %}"
                    data-xpr-gallery-trigger
                    data-xpr-gallery-src="{{ review_strip_full_url }}"
                    aria-label="Preview customer review photo"
                  >
                    {{ block.settings.image_1 | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
                  </button>
                {%- endif -%}
                {%- if media_rendered < section.settings.media_limit and block.settings.image_2 != blank -%}
                  {%- assign media_rendered = media_rendered | plus: 1 -%}
                  {%- assign review_strip_full_url = block.settings.image_2 | image_url: width: 1800 -%}
                  <button
                    type="button"
	                    class="xpr-media-thumb{% if media_rendered > 3 %} xpr-media-thumb--mobile-hidden{% endif %}"
                    data-xpr-gallery-trigger
                    data-xpr-gallery-src="{{ review_strip_full_url }}"
                    aria-label="Preview customer review photo"
                  >
                    {{ block.settings.image_2 | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
                  </button>
                {%- endif -%}
                {%- if media_rendered < section.settings.media_limit and block.settings.image_3 != blank -%}
                  {%- assign media_rendered = media_rendered | plus: 1 -%}
                  {%- assign review_strip_full_url = block.settings.image_3 | image_url: width: 1800 -%}
                  <button
                    type="button"
	                    class="xpr-media-thumb{% if media_rendered > 3 %} xpr-media-thumb--mobile-hidden{% endif %}"
                    data-xpr-gallery-trigger
                    data-xpr-gallery-src="{{ review_strip_full_url }}"
                    aria-label="Preview customer review photo"
                  >
                    {{ block.settings.image_3 | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
                  </button>
                {%- endif -%}
                {%- if media_rendered < section.settings.media_limit and block.settings.image_4 != blank -%}
                  {%- assign media_rendered = media_rendered | plus: 1 -%}
                  {%- assign review_strip_full_url = block.settings.image_4 | image_url: width: 1800 -%}
                  <button
                    type="button"
	                    class="xpr-media-thumb{% if media_rendered > 3 %} xpr-media-thumb--mobile-hidden{% endif %}"
                    data-xpr-gallery-trigger
                    data-xpr-gallery-src="{{ review_strip_full_url }}"
                    aria-label="Preview customer review photo"
                  >
                    {{ block.settings.image_4 | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '71px', widths: '142,284,420' }}
                  </button>
                {%- endif -%}
                {%- if media_rendered < section.settings.media_limit and block.settings.video_url != blank -%}
                  {%- assign media_rendered = media_rendered | plus: 1 -%}
	                  <div class="xpr-media-thumb{% if media_rendered > 3 %} xpr-media-thumb--mobile-hidden{% endif %}">
                    {{ block.settings.video_url | external_video_tag }}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- if section.settings.media_more_label != blank -%}
              {%- assign media_more_parts = section.settings.media_more_label | escape | split: ' ' -%}
              <button class="xpr-media-more" type="button" data-xpr-gallery-more aria-label="Preview all customer review photos">
                {%- for media_more_part in media_more_parts -%}
                  {%- unless forloop.first -%}<br>{%- endunless -%}
                  {{- media_more_part -}}
                {%- endfor -%}
              </button>
            {%- endif -%}
          </div>
        </div>
	      {%- endif -%}
	    </div>

	    <div class="xpr-gallery-sources" hidden aria-hidden="true">
	      {%- if series_review_media_count > 0 -%}
	        {%- if series_review_media_is_single -%}
	          {%- liquid
	            assign xpr_gallery_image = series_review_media_source
	            if xpr_gallery_image.preview_image != blank
	              assign xpr_gallery_image = xpr_gallery_image.preview_image
	            endif
	          -%}
	          {%- if xpr_gallery_image.width != blank -%}
	            {%- assign xpr_gallery_full_url = xpr_gallery_image | image_url: width: 1800 -%}
	            {%- assign xpr_gallery_thumb_url = xpr_gallery_image | image_url: width: 240 -%}
	            {%- assign xpr_gallery_alt = xpr_gallery_image.alt | default: 'Customer review photo' -%}
	            <span data-xpr-gallery-image data-xpr-gallery-src="{{ xpr_gallery_full_url }}" data-xpr-gallery-thumb="{{ xpr_gallery_thumb_url }}" data-xpr-gallery-alt="{{ xpr_gallery_alt | escape }}"></span>
	          {%- endif -%}
	        {%- else -%}
	          {%- for series_gallery_media in series_review_media_source -%}
	            {%- liquid
	              assign xpr_gallery_image = series_gallery_media
	              if xpr_gallery_image.preview_image != blank
	                assign xpr_gallery_image = xpr_gallery_image.preview_image
	              endif
	            -%}
	            {%- if xpr_gallery_image.width != blank -%}
	              {%- assign xpr_gallery_full_url = xpr_gallery_image | image_url: width: 1800 -%}
	              {%- assign xpr_gallery_thumb_url = xpr_gallery_image | image_url: width: 240 -%}
	              {%- assign xpr_gallery_alt = xpr_gallery_image.alt | default: 'Customer review photo' -%}
	              <span data-xpr-gallery-image data-xpr-gallery-src="{{ xpr_gallery_full_url }}" data-xpr-gallery-thumb="{{ xpr_gallery_thumb_url }}" data-xpr-gallery-alt="{{ xpr_gallery_alt | escape }}"></span>
	            {%- endif -%}
	          {%- endfor -%}
	        {%- endif -%}
	      {%- elsif fallback_review_media_count > 0 -%}
	        {%- for fallback_gallery_media_block in fallback_review_media_blocks -%}
	          {%- if fallback_gallery_media_block.settings.image != blank -%}
	            {%- assign xpr_gallery_full_url = fallback_gallery_media_block.settings.image | image_url: width: 1800 -%}
	            {%- assign xpr_gallery_thumb_url = fallback_gallery_media_block.settings.image | image_url: width: 240 -%}
	            {%- assign xpr_gallery_alt = fallback_gallery_media_block.settings.image.alt | default: 'Customer review photo' -%}
	            <span data-xpr-gallery-image data-xpr-gallery-src="{{ xpr_gallery_full_url }}" data-xpr-gallery-thumb="{{ xpr_gallery_thumb_url }}" data-xpr-gallery-alt="{{ xpr_gallery_alt | escape }}"></span>
	          {%- endif -%}
	        {%- endfor -%}
	      {%- else -%}
	        {%- for media_gallery_block in media_blocks -%}
	          {%- if media_gallery_block.settings.image != blank -%}
	            {%- assign xpr_gallery_full_url = media_gallery_block.settings.image | image_url: width: 1800 -%}
	            {%- assign xpr_gallery_thumb_url = media_gallery_block.settings.image | image_url: width: 240 -%}
	            {%- assign xpr_gallery_alt = media_gallery_block.settings.image.alt | default: 'Customer review photo' -%}
	            <span data-xpr-gallery-image data-xpr-gallery-src="{{ xpr_gallery_full_url }}" data-xpr-gallery-thumb="{{ xpr_gallery_thumb_url }}" data-xpr-gallery-alt="{{ xpr_gallery_alt | escape }}"></span>
	          {%- endif -%}
	        {%- endfor -%}

	        {%- for review_gallery_block in review_blocks -%}
	          {%- if review_gallery_block.settings.image_1 != blank -%}
	            {%- assign xpr_gallery_full_url = review_gallery_block.settings.image_1 | image_url: width: 1800 -%}
	            {%- assign xpr_gallery_thumb_url = review_gallery_block.settings.image_1 | image_url: width: 240 -%}
	            {%- assign xpr_gallery_alt = review_gallery_block.settings.image_1.alt | default: 'Customer review photo' -%}
	            <span data-xpr-gallery-image data-xpr-gallery-src="{{ xpr_gallery_full_url }}" data-xpr-gallery-thumb="{{ xpr_gallery_thumb_url }}" data-xpr-gallery-alt="{{ xpr_gallery_alt | escape }}"></span>
	          {%- endif -%}
	          {%- if review_gallery_block.settings.image_2 != blank -%}
	            {%- assign xpr_gallery_full_url = review_gallery_block.settings.image_2 | image_url: width: 1800 -%}
	            {%- assign xpr_gallery_thumb_url = review_gallery_block.settings.image_2 | image_url: width: 240 -%}
	            {%- assign xpr_gallery_alt = review_gallery_block.settings.image_2.alt | default: 'Customer review photo' -%}
	            <span data-xpr-gallery-image data-xpr-gallery-src="{{ xpr_gallery_full_url }}" data-xpr-gallery-thumb="{{ xpr_gallery_thumb_url }}" data-xpr-gallery-alt="{{ xpr_gallery_alt | escape }}"></span>
	          {%- endif -%}
	          {%- if review_gallery_block.settings.image_3 != blank -%}
	            {%- assign xpr_gallery_full_url = review_gallery_block.settings.image_3 | image_url: width: 1800 -%}
	            {%- assign xpr_gallery_thumb_url = review_gallery_block.settings.image_3 | image_url: width: 240 -%}
	            {%- assign xpr_gallery_alt = review_gallery_block.settings.image_3.alt | default: 'Customer review photo' -%}
	            <span data-xpr-gallery-image data-xpr-gallery-src="{{ xpr_gallery_full_url }}" data-xpr-gallery-thumb="{{ xpr_gallery_thumb_url }}" data-xpr-gallery-alt="{{ xpr_gallery_alt | escape }}"></span>
	          {%- endif -%}
	          {%- if review_gallery_block.settings.image_4 != blank -%}
	            {%- assign xpr_gallery_full_url = review_gallery_block.settings.image_4 | image_url: width: 1800 -%}
	            {%- assign xpr_gallery_thumb_url = review_gallery_block.settings.image_4 | image_url: width: 240 -%}
	            {%- assign xpr_gallery_alt = review_gallery_block.settings.image_4.alt | default: 'Customer review photo' -%}
	            <span data-xpr-gallery-image data-xpr-gallery-src="{{ xpr_gallery_full_url }}" data-xpr-gallery-thumb="{{ xpr_gallery_thumb_url }}" data-xpr-gallery-alt="{{ xpr_gallery_alt | escape }}"></span>
	          {%- endif -%}
	        {%- endfor -%}
	      {%- endif -%}
	    </div>

	    {%- if section.settings.show_summary and section.settings.summary_note != blank -%}
	      <div class="xpr-summary">
        {%- if section.settings.summary_heading != blank -%}
          <h3 class="xpr-summary__heading">{{ section.settings.summary_heading | escape }}</h3>
        {%- endif -%}
        <div class="xpr-summary__body">{{ section.settings.summary_note }}</div>
        {%- if section.settings.summary_caption != blank -%}
          <div class="xpr-summary__caption">{{ section.settings.summary_caption | escape }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.list_heading != blank or section.settings.sort_label != blank -%}
      <div class="xpr-toolbar">
        {%- if section.settings.list_heading != blank -%}
          <div class="xpr-toolbar__title">{{ section.settings.list_heading | escape }}</div>
        {%- endif -%}
        {%- if section.settings.sort_label != blank -%}
          <div class="xpr-toolbar__pill">{{ section.settings.sort_label | escape }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if review_count > 0 -%}
      <div class="xpr-list" data-xpr-list>
        {%- for rendered_review_count in (1..review_count) -%}
          {%- liquid
            assign review_source_zero_index = rendered_review_count | minus: 1 | plus: review_offset | modulo: review_source_count
            assign review_source_number = review_source_zero_index | plus: 1
            assign fallback_review_block = blank

            if review_blocks.size > 0
              assign fallback_block_index = review_source_zero_index | modulo: review_blocks.size
              for candidate_review_block in review_blocks offset: fallback_block_index limit: 1
                assign fallback_review_block = candidate_review_block
              endfor
            endif

            assign display_review_title = blank
            if review_text_count == 0 and fallback_review_block.settings.title != blank
              assign display_review_title = fallback_review_block.settings.title
            endif

            assign display_review_body = fallback_review_block.settings.body
            assign display_review_body_from_pool = false
            if review_text_count > 0
              assign display_review_body = blank
              assign review_text_seen = 0
              for review_text_line in review_text_lines
                assign review_text_line_content = review_text_line | strip
                if review_text_line_content != blank
                  assign review_text_seen = review_text_seen | plus: 1
                  if review_text_seen == review_source_number
                    assign display_review_body = review_text_line_content
                    assign display_review_body_from_pool = true
                    break
                  endif
                endif
              endfor
            endif

            assign display_review_date = fallback_review_block.settings.date
            if enable_random_review_dates
              assign review_date_random_seed = review_random_seed_base | plus: rendered_review_count | times: 37 | plus: 17
              assign review_date_days_offset = review_date_random_seed | modulo: review_date_range_size | plus: review_date_range_start
              assign review_date_seconds_offset = review_date_days_offset | times: 86400
              assign display_review_date_timestamp = 'now' | date: '%s' | minus: review_date_seconds_offset
              assign display_review_date = display_review_date_timestamp | date: review_date_format
            endif

            assign display_review_rating = fallback_review_block.settings.rating | default: 5 | plus: 0
            if enable_random_review_ratings
              assign review_rating_random_seed = review_random_seed_base | plus: rendered_review_count | times: 53 | plus: 31
              assign review_rating_halves = review_rating_random_seed | modulo: review_rating_range_size | plus: review_rating_min_halves
              assign display_review_rating = review_rating_halves | divided_by: 2.0
            endif

            if display_review_rating > 5
              assign display_review_rating = 5
            elsif display_review_rating < 1
              assign display_review_rating = 5
            endif

            assign fallback_media_count = 0
            assign fallback_review_image = blank
            if series_review_media_count == 0 and fallback_review_media_count > 0
              assign fallback_review_media_source_number = rendered_review_count | minus: 1 | plus: fallback_review_media_offset | modulo: fallback_review_media_count | plus: 1
              assign fallback_review_media_seen = 0
              for fallback_media_block in fallback_review_media_blocks
                if fallback_media_block.settings.image != blank
                  assign fallback_review_media_seen = fallback_review_media_seen | plus: 1
                  if fallback_review_media_seen == fallback_review_media_source_number
                    assign fallback_review_image = fallback_media_block.settings.image
                    break
                  endif
                endif
              endfor
            endif

            if fallback_review_image != blank
              assign fallback_media_count = 1
            else
              if fallback_review_block.settings.image_1 != blank
                assign fallback_media_count = fallback_media_count | plus: 1
              endif
              if fallback_review_block.settings.image_2 != blank
                assign fallback_media_count = fallback_media_count | plus: 1
              endif
              if fallback_review_block.settings.image_3 != blank
                assign fallback_media_count = fallback_media_count | plus: 1
              endif
              if fallback_review_block.settings.image_4 != blank
                assign fallback_media_count = fallback_media_count | plus: 1
              endif
              if fallback_review_block.settings.video_url != blank
                assign fallback_media_count = fallback_media_count | plus: 1
              endif
            endif

            assign series_review_image = blank
            if series_review_media_count > 0 and rendered_review_count <= series_review_media_count
              if series_review_media_is_single
                if rendered_review_count == 1
                  assign series_review_image = series_review_media_source
                  if series_review_image.preview_image != blank
                    assign series_review_image = series_review_image.preview_image
                  endif
                endif
              else
                assign series_media_seen = 0
                for series_review_media in series_review_media_source
                  assign series_review_image_candidate = series_review_media
                  if series_review_image_candidate.preview_image != blank
                    assign series_review_image_candidate = series_review_image_candidate.preview_image
                  endif

                  if series_review_image_candidate.width != blank
                    assign series_media_seen = series_media_seen | plus: 1
                    if series_media_seen == rendered_review_count
                      assign series_review_image = series_review_image_candidate
                      break
                    endif
                  endif
                endfor
              endif
            endif

            assign media_count = fallback_media_count
            if series_review_image != blank
              assign media_count = 1
            endif

            assign media_columns = media_count
            if media_columns > 4
              assign media_columns = 4
            endif
          -%}

          <article
            class="xpr-review-row"
            data-xpr-card
            {% if rendered_review_count > section.settings.initial_visible_reviews %}hidden{% endif %}
            {% if review_text_count == 0 and fallback_review_block != blank %}{{ fallback_review_block.shopify_attributes }}{% endif %}
