<section
  class="xstrape-home-scope xh-section"
  style="--xh-page-bg: {{ section.settings.page_background | default: '#F2F9ED' }}; --xh-text: {{ section.settings.text_color | default: '#17132F' }}; --xh-muted: {{ section.settings.muted_text_color | default: '#5C566E' }};"
>
  <div class="xh-container">
    <div class="xh-promo-grid">
      {% for block in section.blocks %}
        <a class="xh-media-card" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
          <span class="xh-media-card__image">
            {% if block.settings.image != blank %}
              {%- liquid
                assign promo_image = block.settings.image
                assign promo_image_alt = promo_image.alt | default: block.settings.title | escape
                assign promo_image_height = 1400 | divided_by: promo_image.aspect_ratio | round
              -%}
              <img
                src="{{ promo_image | image_url: width: 720 }}"
                srcset="
                  {{ promo_image | image_url: width: 360 }} 360w,
                  {{ promo_image | image_url: width: 480 }} 480w,
                  {{ promo_image | image_url: width: 600 }} 600w,
                  {{ promo_image | image_url: width: 720 }} 720w,
                  {{ promo_image | image_url: width: 900 }} 900w,
                  {{ promo_image | image_url: width: 1200 }} 1200w,
                  {{ promo_image | image_url: width: 1400 }} 1400w
                "
                width="1400"
                height="{{ promo_image_height }}"
                loading="lazy"
                sizes="(max-width: 699px) calc(100vw - 40px), (max-width: 999px) calc(100vw - 40px), min(50vw, 720px)"
                alt="{{ promo_image_alt }}"
              >
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'xh-media-card__placeholder' }}
            {% endif %}
          </span>
          <span class="xh-media-card__body">
            {% if block.settings.kicker != blank %}
              <span class="xh-eyebrow" style="color: rgb(255 255 255 / 0.78);">{{ block.settings.kicker | escape }}</span>
            {% endif %}
            {% if block.settings.title != blank %}
              <span class="xh-media-card__title">{{ block.settings.title | escape }}</span>
            {% endif %}
            {% if block.settings.text != blank %}
              <span class="xh-media-card__text">{{ block.settings.text | escape }}</span>
            {% endif %}
            {% if block.settings.button_text != blank %}
              <span class="xh-pill-button" style="margin-top: 1.15rem;">{{ block.settings.button_text | escape }}</span>
            {% endif %}
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "促销图文区",
  "class": "shopify-section--xstrape-promo-grid",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "page_background",
      "label": "背景",
      "default": "#F2F9ED"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字",
      "default": "#17132F"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "次要文字",
      "default": "#5C566E"
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "促销卡片",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "小标题"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Promo title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "文字"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "按钮文字",
          "default": "Shop now"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "促销图文区"
    }
  ]
}
{% endschema %}
