    },
    {
      "type": "text",
      "id": "about_collection_heading",
      "label": "系列区标题",
      "default": "Find the kind of fun that fits their day."
    },
    {
      "type": "header",
      "content": "关于我们底部行动区"
    },
    {
      "type": "text",
      "id": "about_cta_kicker",
