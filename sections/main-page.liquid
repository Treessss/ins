        {
          "value": "60ch",
          "label": "小"
        },
        {
          "value": "80ch",
          "label": "中"
        },
        {
          "value": "100ch",
          "label": "大"
        },
        {
          "value": "120ch",
          "label": "特大"
        },
        {
          "value": "100%",
          "label": "全宽"
        }
      ],
      "default": "80ch"
    },
    {
      "type": "header",
      "content": "关于我们顶部横幅"
    },
    {
      "type": "image_picker",
      "id": "about_hero_image",
      "label": "顶部横幅桌面图片"
    },
    {
      "type": "image_picker",
      "id": "about_hero_mobile_image",
