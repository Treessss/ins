          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Play with purpose"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "描述",
          "default": "Every product starts with a real pet behavior—from chewing and chasing to hiding and settling in."
        }
      ]
    },
    {
      "type": "step",
      "name": "流程步骤",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "步骤编号",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "步骤标题",
          "default": "Watch how pets play"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "步骤描述",
          "default": "We begin with instinctive behaviors such as pawing, pouncing, kicking, sniffing, and resting."
        }
      ]
    },
    {
      "type": "collection_card",
