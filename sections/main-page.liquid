    },
    {
      "type": "text",
      "id": "about_hero_image_alt",
      "label": "顶部图片替代文字",
      "default": "Pet exploring an xstrapetm enrichment toy"
    },
    {
      "type": "text",
      "id": "about_hero_eyebrow",
      "label": "顶部小标题",
      "default": "About XSTRAPETM"
