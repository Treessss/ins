</style>

{%- capture product_form_id -%}product-form-{{ product.id }}-{{ section.id }}{%- endcapture -%}

<div {% render 'section-properties', tight: true %}>
  <product-rerender id="product-info-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}" allow-partial-rerender>
    <div class="product">
      <div class="product__main-grid">
        {%- if product.media.size > 0 -%}
          {%- render 'product-gallery', product: product, product_form_id: product_form_id -%}
        {%- endif -%}

        <div class="product-info-column">
          <div class="product-info-panel">
            {%- render 'product-info',
              product: product,
              update_url: true,
              product_form_id: product_form_id,
              context: 'main_product'
            -%}
          </div>

          {%- liquid
            assign also_bought_products = product.metafields.custom.also_bought_products.value
            assign also_bought_skip_current = true
            if also_bought_products == blank
              assign also_bought_products = section.settings.also_bought_fallback_products
              assign also_bought_skip_current = false
            endif
            if also_bought_products == blank
              assign fallback_collection = product.collections | first
              assign also_bought_products = fallback_collection.products
              assign also_bought_skip_current = true
            endif

            assign also_bought_count = 0
          -%}

          {%- capture also_bought_cards -%}
            {%- for recommended_product in also_bought_products -%}
              {%- if also_bought_skip_current and recommended_product.id == product.id -%}
                {%- continue -%}
              {%- endif -%}

              {%- assign recommended_variant = recommended_product.selected_or_first_available_variant -%}
              {%- assign also_bought_count = also_bought_count | plus: 1 -%}

              <div class="product-info__also-bought-card">
                <a href="{{ recommended_product.url }}" class="product-info__also-bought-image" aria-label="{{ recommended_product.title | escape }}">
                  {%- if recommended_product.featured_media != blank -%}
                    {{- recommended_product.featured_media | image_url: width: 260 | image_tag: loading: 'lazy', widths: '140,200,260', sizes: '96px', alt: recommended_product.title -}}
                  {%- endif -%}
                </a>

                <a href="{{ recommended_product.url }}" class="product-info__also-bought-text">
                  <p class="product-info__also-bought-name">{{ recommended_product.title }}</p>
                  <p class="product-info__also-bought-price">
                    {%- if recommended_variant.compare_at_price != blank and recommended_variant.compare_at_price > recommended_variant.price -%}
                      <span class="product-info__also-bought-compare">{{ recommended_variant.compare_at_price | money_without_trailing_zeros }}</span>
                    {%- endif -%}
                    <span>{{ recommended_variant.price | money_without_trailing_zeros }}</span>
                  </p>
                </a>

                {%- form 'product', recommended_product, class: 'product-info__also-bought-form' -%}
                  <input type="hidden" name="id" value="{{ recommended_variant.id }}">
                  <button type="submit" class="product-info__also-bought-add" aria-label="Add {{ recommended_product.title | escape }} to cart">+</button>
                {%- endform -%}
              </div>

              {%- if also_bought_count == 2 -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}

          {%- if also_bought_count > 0 -%}
            <div class="product-info__also-bought">
              <h2 class="product-info__also-bought-title">Others Like You Also Bought:</h2>
              <div class="product-info__also-bought-grid">
                {{- also_bought_cards -}}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="product-description-below">
        {%- comment -%}Anchor tabs: only show buttons for sections that have content{%- endcomment -%}
        {%- assign pm_pc_desc_banner = product.metafields.custom.pm_pc_desc_banner.value -%}
        {%- assign pm_mobile_desc_banner = product.metafields.custom.pm_mobile_desc_banner.value -%}
        {%- assign pm_desc_video_overview = product.metafields.custom.pm_desc_video_overview.value | default: product.metafields.custom.pm_desc_video_overview -%}
        {%- assign pm_desc_video_review = product.metafields.custom.pm_desc_video_review.value | default: product.metafields.custom.pm_desc_video_review -%}
        {%- assign pm_desc_video_installation = product.metafields.custom.pm_desc_video_installation.value | default: product.metafields.custom.pm_desc_video_installation -%}

        {%- assign pm_desc_1_image = product.metafields.custom.pm_desc_1_image.value -%}
        {%- assign pm_desc_1_title = product.metafields.custom.pm_desc_1_title.value | default: product.metafields.custom.pm_desc_1_title -%}
        {%- assign pm_desc_1_content = product.metafields.custom.pm_desc_1_content.value | default: product.metafields.custom.pm_desc_1_content -%}

        {%- assign pm_desc_2_image = product.metafields.custom.pm_desc_2_image.value -%}
        {%- assign pm_desc_2_title = product.metafields.custom.pm_desc_2_title.value | default: product.metafields.custom.pm_desc_2_title -%}
        {%- assign pm_desc_2_content = product.metafields.custom.pm_desc_2_content.value | default: product.metafields.custom.pm_desc_2_content -%}

        {%- assign pm_desc_3_image = product.metafields.custom.pm_desc_3_image.value -%}
        {%- assign pm_desc_3_title = product.metafields.custom.pm_desc_3_title.value | default: product.metafields.custom.pm_desc_3_title -%}
        {%- assign pm_desc_3_content = product.metafields.custom.pm_desc_3_content.value | default: product.metafields.custom.pm_desc_3_content -%}

        {%- assign pm_desc_4_image = product.metafields.custom.pm_desc_4_image.value -%}
        {%- assign pm_desc_4_title = product.metafields.custom.pm_desc_4_title.value | default: product.metafields.custom.pm_desc_4_title -%}
        {%- assign pm_desc_4_content = product.metafields.custom.pm_desc_4_content.value | default: product.metafields.custom.pm_desc_4_content -%}

        {%- assign pm_desc_5_image = product.metafields.custom.pm_desc_5_image.value -%}
        {%- assign pm_desc_5_title = product.metafields.custom.pm_desc_5_title.value | default: product.metafields.custom.pm_desc_5_title -%}
        {%- assign pm_desc_5_content = product.metafields.custom.pm_desc_5_content.value | default: product.metafields.custom.pm_desc_5_content -%}

        {%- assign pm_desc_6_image = product.metafields.custom.pm_desc_6_image.value -%}
        {%- assign pm_desc_6_title = product.metafields.custom.pm_desc_6_title.value | default: product.metafields.custom.pm_desc_6_title -%}
        {%- assign pm_desc_6_content = product.metafields.custom.pm_desc_6_content.value | default: product.metafields.custom.pm_desc_6_content -%}

        {%- assign pm_more_info = product.metafields.custom.pm_more_info.value | default: product.metafields.custom.pm_more_info -%}
        {%- assign description_detail_blocks = section.blocks | where: 'type', 'description_detail_item' -%}
        {%- assign description_detail_count = 0 -%}
        {%- for detail_block in description_detail_blocks -%}
          {%- liquid
            assign detail_metafield_key = detail_block.settings.product_metafield_key | strip
            assign detail_metafield_value = blank

            if detail_metafield_key != blank
              assign detail_metafield_value = product.metafields.custom[detail_metafield_key].value | default: product.metafields.custom[detail_metafield_key]
            endif

            assign detail_content = detail_metafield_value | default: detail_block.settings.content
          -%}
          {%- if detail_block.settings.title != blank and detail_content != blank -%}
            {%- assign description_detail_count = description_detail_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign has_overviews = false -%}
        {%- if pm_pc_desc_banner != blank or pm_mobile_desc_banner != blank -%}{%- assign has_overviews = true -%}{%- endif -%}
        {%- if pm_desc_1_image != blank or pm_desc_1_title != blank or pm_desc_1_content != blank -%}{%- assign has_overviews = true -%}{%- endif -%}
        {%- if pm_desc_2_image != blank or pm_desc_2_title != blank or pm_desc_2_content != blank -%}{%- assign has_overviews = true -%}{%- endif -%}
        {%- if pm_desc_3_image != blank or pm_desc_3_title != blank or pm_desc_3_content != blank -%}{%- assign has_overviews = true -%}{%- endif -%}
        {%- if pm_desc_4_image != blank or pm_desc_4_title != blank or pm_desc_4_content != blank -%}{%- assign has_overviews = true -%}{%- endif -%}
        {%- if pm_desc_5_image != blank or pm_desc_5_title != blank or pm_desc_5_content != blank -%}{%- assign has_overviews = true -%}{%- endif -%}
        {%- if pm_desc_6_image != blank or pm_desc_6_title != blank or pm_desc_6_content != blank -%}{%- assign has_overviews = true -%}{%- endif -%}

        {%- assign has_videos = false -%}
        {%- if pm_desc_video_overview != blank or pm_desc_video_review != blank or pm_desc_video_installation != blank -%}{%- assign has_videos = true -%}{%- endif -%}

        {%- assign has_description = false -%}
        {%- if description_detail_count > 0 -%}{%- assign has_description = true -%}{%- endif -%}

        <div class="fivestopsproduct-container">
          {%- if has_description -%}
            <div id="pm-description-anchor-{{ section.id }}" class="pm-more-info pm-product-description">
              {%- if description_detail_count > 0 -%}
                <div class="pm-product-description__details">
                  {%- for detail_block in description_detail_blocks -%}
                    {%- liquid
                      assign detail_metafield_key = detail_block.settings.product_metafield_key | strip
                      assign detail_metafield_value = blank
                      assign detail_title_handle = detail_block.settings.title | handleize
                      assign is_product_description_detail = false

                      if detail_metafield_key != blank
                        assign detail_metafield_value = product.metafields.custom[detail_metafield_key].value | default: product.metafields.custom[detail_metafield_key]
                      endif

                      if detail_metafield_key == 'detail_description'
                        assign is_product_description_detail = true
                      endif

                      if detail_title_handle == 'product-description'
                        assign is_product_description_detail = true
                      endif

                      assign detail_content = detail_metafield_value | default: detail_block.settings.content
                      if product.description != blank and is_product_description_detail
                        assign detail_content = product.description
                      endif
                      assign detail_icon = detail_block.settings.icon
                    -%}

                    {%- if detail_block.settings.title != blank and detail_content != blank -%}
                      <details class="pm-product-description__detail" {% if detail_block.settings.open_by_default %}open{% endif %} {{ detail_block.shopify_attributes }}>
                        <summary class="pm-product-description__summary">
                          <span class="pm-product-description__icon" aria-hidden="true">
                            {%- if detail_block.settings.custom_icon != blank -%}
                              {{-
                                detail_block.settings.custom_icon
                                | image_url: width: 60
                                | image_tag: loading: 'lazy', widths: '30,60', sizes: '30px'
                              -}}
                            {%- elsif detail_icon != 'none' -%}
                              {%- render 'icon' with detail_icon, width: 28, height: 28 -%}
                            {%- endif -%}
                          </span>
                          <span class="pm-product-description__title">{{ detail_block.settings.title | escape }}</span>
                          <span class="pm-product-description__chevron" aria-hidden="true">{%- render 'icon' with 'chevron-bottom', width: 12, height: 8 -%}</span>
                        </summary>
                        <div class="pm-product-description__content">
                          <div class="prose">
                            {{- detail_content -}}
                          </div>
                        </div>
                      </details>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          <!-- Overviews -->
          {%- if has_overviews -%}
          <div id="pm-overviews-{{ section.id }}" class="fivestopsproduct_Overviews">
            <!-- 5 stop product overview -->
            <!-- banner -->
            {%- assign pm_pc_desc_banner = product.metafields.custom.pm_pc_desc_banner.value -%}
            {%- assign pm_mobile_desc_banner = product.metafields.custom.pm_mobile_desc_banner.value -%}

            {%- if pm_pc_desc_banner != blank or pm_mobile_desc_banner != blank -%}
              <div class="Overviews_banner">
                <picture>
                  {%- if pm_mobile_desc_banner != blank -%}
                    <source
                      media="(max-width: 999px)"
                      srcset="
                        {{ pm_mobile_desc_banner | image_url: width: 360 }} 360w,
                        {{ pm_mobile_desc_banner | image_url: width: 540 }} 540w,
                        {{ pm_mobile_desc_banner | image_url: width: 720 }} 720w,
                        {{ pm_mobile_desc_banner | image_url: width: 900 }} 900w
                      "
