                  const items = Array.isArray(data?.faq) ? data.faq : [];
                  if (items.length === 0) return;

                  const listHtml = items
                    .map((it, idx) => {
                      const q = it?.question ?? '';
                      const a = it?.answer ?? '';
                      return `
                        <div class="pm-faq__item" data-idx="${idx}">
                          <div class="pm-faq__a-wrap">
                            <div class="pm-faq__q-text">${escapeHtml(q)}</div>
                            <div class="pm-faq__a">${escapeHtml(a)}</div>
                          </div>
                        </div>
                      `;
                    })
                    .join('');

                  container.innerHTML = `<div class="pm-faq__list">${listHtml}</div>`;

                  // After rendering, sync the whole FAQ height
                  syncHeight();

                  window.addEventListener(
                    'resize',
                    () => {
                      syncHeight();
                    },
                    { passive: true }
                  );

                  if (toggleBtn) {
                    toggleBtn.addEventListener('click', () => {
                      const collapsed = root.classList.toggle('is-collapsed');
                      toggleBtn.setAttribute('aria-expanded', String(!collapsed));
                      syncHeight();
                    });
                  }
                })();
              </script>
            {%- endif -%}
          </div>

          <!-- Reviews -->
          <div id="pm-reviews-anchor-{{ section.id }}" class="fivestopsproduct_Reviews"></div>
        </div>
      </div>
    </div>
  </product-rerender>
</div>

{%- assign buy_buttons_block = section.blocks | where: 'type', 'buy_buttons' | first -%}
{%- assign is_custom_case_launch_button = false -%}

{%- if product.template_suffix == 'custom-phone-case' -%}
  {%- assign is_custom_case_launch_button = true -%}
{%- endif -%}

{%- if section.settings.show_fixed_add_to_cart and product.available and buy_buttons_block != blank -%}
  {%- capture sticky_quick_buy_id -%}sticky-quick-buy-{{ section.id }}-{{ product.id }}{%- endcapture -%}

  <product-rerender id="{{ product_form_id }}-sticky-bar" observe-form="{{ product_form_id }}">
    {%- if product.selected_or_first_available_variant.available -%}
      <product-quick-add form="{{ product_form_id }}" class="product-quick-add">
        {%- if is_custom_case_launch_button -%}
          {%- assign button_label = 'Customize Now' -%}
        {%- else -%}
          {%- assign button_label = 'product.general.add_to_cart_button' | t -%}
        {%- endif -%}
        {%- capture sticky_button_data_attributes -%}
          data-atc-button
          data-button-label="{{ button_label | escape }}"
          {%- if is_custom_case_launch_button -%}
            data-custom-case-launch
            data-custom-case-form-id="{{ product_form_id | escape }}"
            data-custom-case-product-url="{{ product.url | escape }}"
          {%- endif -%}
        {%- endcapture -%}
        {%- assign sticky_button_aria_controls = sticky_quick_buy_id -%}
        {%- if is_custom_case_launch_button -%}
          {%- assign sticky_button_aria_controls = blank -%}
        {%- endif -%}

        <div class="sm:hidden">
          {%- render 'button', type: 'button', content: button_label, aria_controls: sticky_button_aria_controls, background: buy_buttons_block.settings.atc_button_background, text_color: buy_buttons_block.settings.atc_button_text_color, secondary: true, stretch: true, size: 'lg', data_attributes: sticky_button_data_attributes -%}
        </div>

        {%- assign image = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}

        <div class="product-quick-add__variant {% if image == blank %}no-image{% endif %} hidden sm:grid">
          {%- if image != blank -%}
            <variant-media widths="80,160" form="{{ product_form_id }}">
              {{- image | image_url: width: 160 | image_tag: loading: 'lazy', sizes: '80px', widths: '80,160', class: 'rounded-xs' -}}
            </variant-media>
          {%- endif -%}

          <div class="v-stack gap-0.5">
            {%- assign vendor_block = section.blocks | where: 'type', 'vendor' -%}

            {%- if vendor_block != blank -%}
              {%- render 'vendor' with product.vendor, class: 'text-xs' -%}
            {%- endif -%}

            <a href="{{ product.url }}" class="bold truncate-text">{{ product.title }}</a>
            {%- render 'price-list', product: product, variant: product.selected_or_first_available_variant, form_id: product_form_id -%}
          </div>

          {%- render 'button', type: 'button', content: button_label, aria_controls: sticky_button_aria_controls, background: buy_buttons_block.settings.atc_button_background, text_color: buy_buttons_block.settings.atc_button_text_color, secondary: true, data_attributes: sticky_button_data_attributes -%}
        </div>
      </product-quick-add>

    {%- endif -%}
  </product-rerender>

  {%- unless is_custom_case_launch_button -%}
    <quick-buy-drawer id="{{ sticky_quick_buy_id }}" header-bordered open-from="bottom" handle="{{ product.handle }}?variant={{ product.selected_or_first_available_variant.id }}" data-product-handle="{{ product.handle }}" data-product-form="{{ product_form_id }}" role="region" aria-live="polite" class="quick-buy-drawer quick-buy-drawer--case-variants drawer">
      {%- comment -%}Quick buy content is filled on demand for performance reasons {%- endcomment -%}
    </quick-buy-drawer>
  {%- endunless -%}
{%- endif -%}

{%- comment -%}
IMPLEMENTATION NOTE: Shopify does not currently allows to render a given section within the context of a given product. However,
when rendering the quick buy popovers, we want to be able to re-use the merchant's choices (such as the selector type). This
is however only possible by rendering the whole product page, and extracting the relevant part. Here, we therefore render the
quick buy information in a template, that will be extracted in JS, but ensure it is not visible in the main product page
{%- endcomment -%}

{%- render 'product-quick-buy', product: product -%}

