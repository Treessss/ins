    #shopify-section-{{ section.id }} .block-swatch--option-image-fallback {
      --case-type-pill-width: min(360px, calc(100vw - 64px));
      width: var(--case-type-pill-width);
      max-width: 100%;
      flex-basis: var(--case-type-pill-width);
      min-height: 44px;
      grid-column: 1 / -1;
      justify-self: center;
      padding-inline: 18px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
