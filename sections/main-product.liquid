      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .product-info__series-list {
      --series-tile-size: 100%;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .product-info__series-tile {
      width: 100%;
      font-size: 12px;
      line-height: 1.08;
    }

    #shopify-section-{{ section.id }} .product-info__series-image {
