<section
  class="xstrape-home-scope xh-section xh-favorites"
  style="--xh-page-bg: {{ section.settings.page_background | default: '#F2F9ED' }}; --xh-text: {{ section.settings.text_color | default: '#17132F' }}; --xh-muted: {{ section.settings.muted_text_color | default: '#5C566E' }}; --xh-accent: {{ section.settings.accent_color | default: '#17132F' }};"
>
  <div class="xh-container">
    <div class="xh-section-header">
      <div>
        {% if section.settings.products_kicker != blank %}
          <p class="xh-eyebrow">{{ section.settings.products_kicker | escape }}</p>
        {% endif %}
        {% if section.settings.products_title != blank %}
          <h2 class="xh-heading">{{ section.settings.products_title | escape }}</h2>
        {% endif %}
      </div>
      {% if section.settings.products_link_text != blank %}
        <a class="xh-pill-button" {% if section.settings.products_link_url != blank %}href="{{ section.settings.products_link_url }}"{% endif %}>{{ section.settings.products_link_text | escape }}</a>
      {% endif %}
    </div>

    <div class="xh-product-list">
      {% assign favorite_blocks = section.blocks | where: 'type', 'favorite' %}
      {% assign featured_collection = section.settings.products_collection %}
      {% if favorite_blocks.size > 0 %}
        {% for block in favorite_blocks %}
          <a class="xh-favorite-card" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
            <span class="xh-favorite-card__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 480
                  | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 72vw, (max-width: 999px) 44vw, min(25vw, 353px)', widths: '220,280,340,420,480'
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </span>
            <span class="xh-favorite-card__body">
              {% if block.settings.title != blank %}
                <span class="xh-favorite-card__title">{{ block.settings.title | escape }}</span>
              {% endif %}
              {% if block.settings.text != blank %}
                <span class="xh-favorite-card__text">{{ block.settings.text | escape }}</span>
              {% endif %}
              {% if block.settings.price != blank %}
                <span class="xh-favorite-card__price">{{ block.settings.price | escape }}</span>
              {% endif %}
            </span>
          </a>
        {% endfor %}
      {% elsif featured_collection != blank and featured_collection.products_count > 0 %}
        {% for product in featured_collection.products limit: section.settings.products_count %}
          {% render 'product-card', product: product, show_quick_add: true, show_badges: true %}
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.products_count) %}
          {% capture placeholder_image %}product-{% cycle '1', '2', '3', '4', '5', '6' %}{% endcapture %}
          {% render 'product-card-placeholder', placeholder_image: placeholder_image, stacked: true %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "热卖推荐",
  "class": "shopify-section--xstrape-favorites",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "products_kicker",
      "label": "小标题"
    },
    {
      "type": "text",
      "id": "products_title",
      "label": "标题",
      "default": "Gear You'll Love"
    },
    {
      "type": "collection",
      "id": "products_collection",
      "label": "商品系列"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "显示商品数量",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "products_link_text",
      "label": "查看全部文字"
    },
    {
      "type": "url",
      "id": "products_link_url",
      "label": "查看全部链接"
    },
    {
      "type": "header",
      "content": "颜色"
    },
    {
      "type": "color",
      "id": "page_background",
      "label": "背景",
      "default": "#F2F9ED"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字",
      "default": "#17132F"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "次要文字",
      "default": "#5C566E"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "强调色",
      "default": "#17132F"
    }
  ],
  "blocks": [
    {
      "type": "favorite",
      "name": "推荐商品",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Featured item"
        },
        {
          "type": "text",
          "id": "text",
          "label": "文字"
        },
        {
          "type": "text",
          "id": "price",
          "label": "价格"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "热卖推荐"
    }
  ]
}
{% endschema %}
