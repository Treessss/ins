<section
  class="xstrape-home-scope xh-nomad-link-tiles"
  style="--xh-page-bg: {{ section.settings.page_background | default: '#F2F9ED' }};"
>
  <div class="xh-nomad-link-tiles__grid">
    {% for block in section.blocks %}
      <a class="xh-nomad-link-tile" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
        <span class="xh-nomad-link-tile__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 100vw, 25vw', widths: '360,540,720,900,1200'
            }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {% endif %}
        </span>
        {% if block.settings.title != blank %}
          <span class="xh-nomad-link-tile__title">{{ block.settings.title | escape }}</span>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "横向入口卡片",
  "class": "shopify-section--xstrape-nomad-link-tiles",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "page_background",
      "label": "背景",
      "default": "#F2F9ED"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "卡片",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Shop Gear"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "横向入口卡片",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}
