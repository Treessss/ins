<script>
  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    const items = root.querySelectorAll('[data-xstrape-mega-item]');
    const desktopQuery = window.matchMedia('(min-width: 1150px)');
    const closeTimers = new WeakMap();

    const clearCloseTimer = (item) => {
      const timer = closeTimers.get(item);
      if (timer) window.clearTimeout(timer);
      closeTimers.delete(item);
    };

    const scheduleClose = (item) => {
      clearCloseTimer(item);
      closeTimers.set(item, window.setTimeout(() => {
        item.removeAttribute('open');
        closeTimers.delete(item);
      }, 360));
    };

    const closeSiblings = (activeItem) => {
      items.forEach((item) => {
        clearCloseTimer(item);
        if (item !== activeItem) item.removeAttribute('open');
      });
    };

    items.forEach((item) => {
      const panel = item.querySelector('.xstrape-mega-panel');

      item.addEventListener('mouseenter', () => {
        if (!desktopQuery.matches) return;
        clearCloseTimer(item);
        closeSiblings(item);
        item.setAttribute('open', '');
      });

      item.addEventListener('mouseleave', () => {
        if (!desktopQuery.matches) return;
        scheduleClose(item);
      });

      panel?.addEventListener('mouseenter', () => {
        if (!desktopQuery.matches) return;
        clearCloseTimer(item);
        item.setAttribute('open', '');
      });

      item.querySelector('summary')?.addEventListener('click', () => {
        if (!desktopQuery.matches) return;
        closeSiblings(item);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      items.forEach((item) => item.removeAttribute('open'));
    });
  })();
</script>
